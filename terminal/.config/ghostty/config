# Ghostty Configuration — Open Claw (GitHub Dark)
# https://github.com/ghostty-org/ghostty
# Sized for the welcome TUI + profile fastfetch flow.

# ── Fonts ──────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-feature = "-calt"
font-thicken = true

# ── Window ─────────────────────────────────────────────
# 160×50 leaves margin above the welcome TUI menu + profile fastfetch.
window-decoration = false
window-padding-x = 10
window-padding-y = 10
window-save-state = never
window-width = 160
window-height = 50
macos-titlebar-style = hidden
background-opacity = 0.95
background-blur-radius = 20

# ── macOS Integration ──────────────────────────────────
macos-option-as-alt = true
macos-window-shadow = true
clipboard-read = allow
clipboard-write = allow

# ── Shell integration ──────────────────────────────────
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

# ── GitHub Dark palette (matches dotfiles identity) ────
background = 0d1117
foreground = c9d1d9
selection-background = 58a6ff
selection-foreground = 0d1117
cursor-color = 58a6ff
cursor-text = 0d1117

# Palette
palette = 0=#484f58
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#b1bac4
palette = 8=#6e7681
palette = 9=#ffa198
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#f0f6fc

# ── Keybindings ────────────────────────────────────────
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
keybind = cmd+t=new_tab
