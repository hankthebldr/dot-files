# Ghostty — cross-platform base config (macOS + Linux/GNOME)
# Layering (Ghostty has no OS-conditional include, so we compose with files):
#   1. this file        — directives valid on BOTH platforms
#   2. ?os-active.conf   — per-OS knobs; a symlink → os-macos.conf | os-linux.conf
#                          created by scripts/setup/symlinks.sh (git-ignored).
#   3. ?theme.conf       — active palette, written by `claw theme build`
#                          (git-ignored). LAST so its colors win.
# The leading `?` makes each include optional: a fresh checkout (before stow /
# theme build has run) still loads cleanly instead of erroring on a missing file.
# Font:  JetBrainsMono Nerd Font Mono — 10pt base (Linux/BD790i); macOS
#        bumps to 13pt in os-macos.conf for the Retina panel.
# Keys:  Mac-style — ⌘/Super for copy/paste/tab/window/find/clear

# ── Font ──────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 10
# Ligatures ON (operator pick 2026-08-17): ->, =>, != fuse into glyphs.
# To go back to literal characters, restore:  font-feature = "-calt"
# Heavier strokes are platform-specific and live in the OS layers:
#   macOS → font-thicken;  Linux → freetype-load-flags  (see os-*.conf).
# Tight line height for a dense viewport (was +10%, which loosened rows).
adjust-cell-height = 0%

# ── Window ────────────────────────────────────────────────────────────
# Decorated, movable window. `window-decoration = true` is honored on both
# platforms; the GTK titlebar/tabs knobs that pair with it on Linux live in
# os-linux.conf. `maximize = false` opens floating (a maximized window can't be
# moved); maximize manually with Super+Up / ⌘ controls. Tight padding keeps
# more cells on screen.
maximize = false
window-decoration = true
# Initial size in CELLS (font-independent — a font-size change scales each
# cell, not the grid). Sized for the dashboards: the claw box is 68 cols, the
# generic fastfetch logo 81, and the profile readout + quickref stack ~52 rows.
# 140 cols centers the 81-col art with even margins; 52 rows shows the full
# readout + quickref with no scroll. Ghostty's ~80x24 default can't hold any of
# it. Only applies to new windows (window-save-state = never keeps it authoritative).
window-width = 140
window-height = 52
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = never
window-theme = dark
# New tabs append at the END of the strip (Ghostty default is `current`, which
# inserts mid-strip right after the active tab — the order then jumps around).
window-new-tab-position = end
unfocused-split-opacity = 0.85

# ── Appearance / eye-candy ────────────────────────────────────────────
# Translucent surface. background-blur is honored only on KDE Plasma / macOS;
# GNOME/Mutter ignores it, so it's left to the OS layers rather than implying a
# glass effect that never renders. Opacity works under both compositors —
# drop toward 0.90 for more glass, 1.0 = solid.
background-opacity = 0.93
# Bold text uses the bright ANSI slots → punchier, still on-palette.
bold-is-bright = true
# Nudge legibility when an app paints fg/bg too close together (1.0 = off).
minimum-contrast = 1.05
# Don't flash the cell-size overlay every time the window resizes.
resize-overlay = never

# ── Custom shader (off by default) ────────────────────────────────────
# Drop a .glsl in this dir (e.g. from github.com/hackr-sh/ghostty-shaders —
# cursor smear, CRT, glow) and uncomment to enable. Costs GPU; reload after.
# custom-shader = cursor_smear.glsl
# custom-shader-animation = true

# ── Clipboard ─────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
# `true` copies selections to the SELECTION buffer only (Linux middle-click),
# NOT the system clipboard — so a drag-select never silently overwrites what you
# last cmd+c'd. Was `clipboard`, which clobbered the macOS clipboard on every drag.
copy-on-select = true
# Warn before pasting multi-line / control-char payloads (paste-injection guard).
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# ── Shell integration ─────────────────────────────────────────────────
shell-integration = zsh
# ssh-terminfo auto-installs Ghostty's terminfo on remote hosts (no more
# "unknown terminal: xterm-ghostty" / garbled keys when SSHing the tailnet);
# ssh-env exports a compatible TERM where terminfo can't be installed.
# NOTE: `no-title` explicitly DISABLES Ghostty's title feature. The feature list
# MERGES with the defaults (cursor,sudo,title,path), so simply omitting `title`
# leaves it ON — you must disable it with the `no-` prefix. With title enabled,
# Ghostty injects its OWN preexec hook (title = running command → the "flickering
# processes") and a precmd hook (title = bare cwd) that overwrite the static
# "[profile] user@host: cwd" title from shell/progress.zsh (last writer wins, so
# the shell's title never sticks). `no-title` makes progress.zsh the sole title
# author. Lost: nothing — cwd reporting (`path`) and prompt marks stay on. We
# keep `sudo` (opt-in, off by default — dropping it would disable it) and add
# ssh-env/ssh-terminfo for the tailnet. `cursor`/`path` are default-on.
shell-integration-features = sudo,no-title,ssh-env,ssh-terminfo
mouse-hide-while-typing = true
cursor-style = bar
cursor-style-blink = true

# ── Behavior / QoL ────────────────────────────────────────────────────
# Deep scrollback (bytes), no nag on close, audible + taskbar-attention bell.
scrollback-limit = 100000000
# `true` prompts only when the pane still has a running process (not a per-tab
# nag); guards against cmd+w nuking a live SSH/k8s/build split with no undo.
confirm-close-surface = true
bell-features = system,attention

# ── Colors — baseline fallback (Gruvbox Material dark) ────────────────
# Used on a fresh checkout before any theme is generated. `claw theme build`
# writes the active palette to ./theme.conf and the include below overrides
# these — so the terminal tracks the same single source of truth
# (config/themes/<slug>.theme) as the p10k prompt, EZA_COLORS, fzf, the
# dashboard and the fastfetch readout.
background = 1d2021
foreground = d4be98
selection-background = 45403d
selection-foreground = d4be98
cursor-color = d8a657

palette = 0=#282828
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#928374
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#d4be98

# ── Keybindings (cross-platform) ──────────────────────────────────────
# Ghostty's "cmd" binds to ⌘ on macOS and to Super (Win key) on Linux,
# so a single keybind line works on both platforms. Platform-only binds
# (macOS quick-terminal, Linux Ctrl+Shift fallbacks) live in os-*.conf.

# Clipboard (Mac-style). No cmd+x remap — ⌘X is Cut in every macOS app; binding
# it to copy here was surprising muscle-memory breakage. Selection copy is
# handled by copy-on-select above.
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Tabs. cmd+shift+[ / ] jump tabs; ctrl+tab / ctrl+shift+tab add the
# browser-style cycling most terminals honor (both reach the shell as-is).
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+w=close_tab
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=last_tab

# Windows & splits
keybind = cmd+n=new_window
keybind = cmd+shift+n=new_split:right
# iTerm muscle memory (operator pick 2026-08-17): ⌘D splits right too.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom
# Resize the focused split (ctrl+cmd+hjkl) and rebalance an uneven grid.
keybind = ctrl+cmd+h=resize_split:left,40
keybind = ctrl+cmd+l=resize_split:right,40
keybind = ctrl+cmd+k=resize_split:up,40
keybind = ctrl+cmd+j=resize_split:down,40
keybind = cmd+shift+equal=equalize_splits

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Prompt navigation (powered by shell-integration marks)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Misc
keybind = cmd+k=clear_screen
keybind = cmd+f=write_screen_file:paste
keybind = cmd+q=quit
keybind = cmd+comma=open_config
keybind = cmd+shift+r=reload_config
keybind = cmd+shift+i=inspector:toggle

# ── OS + theme layers (must come LAST; theme wins on color) ────────────
config-file = ?os-active.conf
config-file = ?theme.conf
