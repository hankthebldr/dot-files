# Ghostty — cross-platform config (macOS + Linux/GNOME)
# Theme: follows `claw theme set <slug>` — the active palette is regenerated
#        into ./theme.conf (git-ignored) and included below, so the terminal
#        recolors with the prompt, fzf, dashboard and fastfetch as one surface.
# Font:  JetBrainsMono Nerd Font Mono @ 10pt
# Keys:  Mac-style — ⌘/Super for copy/paste/tab/window/find/clear

# ── Font ──────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 10
font-feature = "-calt"
# font-thicken is macOS-only — no-op on the GTK/freetype Linux build. On Linux,
# heavier strokes come from freetype-load-flags (e.g. hinting, force-autohint).
# font-thicken = true
# Tight line height for a dense viewport (was +10%, which loosened rows).
adjust-cell-height = 0%

# ── Window ────────────────────────────────────────────────────────────
# Decorated, movable window. `window-decoration = true` + `gtk-titlebar = true`
# give the GTK frame + titlebar back, so the window has a border and can be
# dragged/resized on GNOME. `maximize = false` opens it floating (a maximized
# window can't be moved); maximize manually with Super+Up if you want full
# screen. Tight padding keeps more cells on screen.
maximize = false
window-decoration = true
# Initial size in cells. The claw dashboard box is 68 cols, the generic
# fastfetch logo 81, and the profile readout + quickref stack ~52 rows tall —
# Ghostty's built-in default (~80x24) can't center any of it. 140x48 gives the
# welcome TUI room to center with margins and show the readout without scroll.
# Only applies to new windows (window-save-state = never keeps it authoritative).
window-width = 140
window-height = 48
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = never
window-theme = dark
gtk-titlebar = true
gtk-tabs-location = top
gtk-wide-tabs = false
# Reuse one GTK process so new windows open instantly and share memory. Ghostty
# autodetects this but it's unreliable for non-GNOME-launched windows, and the
# launch dashboard makes cold starts costly — force it on.
gtk-single-instance = true
unfocused-split-opacity = 0.85

# ── macOS-only knobs (ignored on Linux) ───────────────────────────────
macos-titlebar-style = hidden
macos-option-as-alt = true
macos-window-shadow = true

# ── Appearance / eye-candy ────────────────────────────────────────────
# Translucent surface. background-blur is honored only on KDE Plasma / macOS;
# GNOME/Mutter (this box is GNOME/X11) ignores it, so it's left off rather than
# implying a glass effect that never renders. Opacity works under GNOME's
# compositor — drop toward 0.90 for more glass, 1.0 = solid.
background-opacity = 0.93
# background-blur = 20   # KDE/macOS only — silent no-op on GNOME/Mutter
# Bold text uses the bright ANSI slots → punchier, still on-palette.
bold-is-bright = true
# Nudge legibility when an app paints fg/bg too close together (1.0 = off).
minimum-contrast = 1.05
# Don't flash the cell-size overlay every time the window resizes.
resize-overlay = never

# ── Quick terminal (drop-down, Guake/Yakuake-style) ───────────────────
# macOS-only in Ghostty 1.3.1: the GTK/Linux build rejects the
# `toggle_quick_terminal` action, so the keybind is commented out to keep this
# shared config valid on Linux. The position/animation tuning below is inert on
# Linux but harmless, and ready for when you're on macOS — just uncomment the
# keybind there. (Linux GNOME drop-down: use a Custom Shortcut → `ghostty`.)
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true
# keybind = global:super+grave=toggle_quick_terminal   # macOS only

# ── Custom shader (off by default) ────────────────────────────────────
# Drop a .glsl in this dir (e.g. from github.com/hackr-sh/ghostty-shaders —
# cursor smear, CRT, glow) and uncomment to enable. Costs GPU; reload after.
# custom-shader = cursor_smear.glsl
# custom-shader-animation = true

# ── Clipboard ─────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
# Warn before pasting multi-line / control-char payloads (paste-injection guard).
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# ── Shell integration ─────────────────────────────────────────────────
shell-integration = zsh
# ssh-terminfo auto-installs Ghostty's terminfo on remote hosts (no more
# "unknown terminal: xterm-ghostty" / garbled keys when SSHing the tailnet);
# ssh-env exports a compatible TERM where terminfo can't be installed.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
mouse-hide-while-typing = true
cursor-style = bar
cursor-style-blink = true

# ── Behavior / QoL ────────────────────────────────────────────────────
# Deep scrollback (bytes), no nag on close, audible + taskbar-attention bell.
scrollback-limit = 100000000
confirm-close-surface = false
bell-features = system,attention

# ── Colors — baseline (Gruvbox Material dark) ─────────────────────────
# This inline palette is the FALLBACK, used on a fresh checkout before any
# theme has been generated. `claw theme set <slug>` writes the active palette
# to ./theme.conf and the include at the end of this file overrides these — so
# the terminal tracks the same single source of truth (config/themes/<slug>.theme)
# as the p10k prompt, EZA_COLORS, fzf, the dashboard and the fastfetch readout.
background = 1d2021
foreground = d4be98
selection-background = 45403d
selection-foreground = d4be98
cursor-color = d8a657

palette = 0=#282828
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#928374
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#d4be98

# Active theme override (generated by `claw theme set`; git-ignored, optional).
# Must come AFTER the baseline palette so its values win when present.
config-file = ?theme.conf

# ── Keybindings ───────────────────────────────────────────────────────
# Ghostty's "cmd" binds to ⌘ on macOS and to Super (Win key) on Linux,
# so a single keybind line works on both platforms.

# Clipboard (Mac-style)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+x=copy_to_clipboard

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+w=close_tab
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=last_tab

# Windows & splits
keybind = cmd+n=new_window
keybind = cmd+shift+n=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Prompt navigation (powered by shell-integration marks)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Misc
keybind = cmd+k=clear_screen
keybind = cmd+f=write_screen_file:paste
keybind = cmd+q=quit
keybind = cmd+comma=open_config
keybind = cmd+shift+r=reload_config
keybind = cmd+shift+i=inspector:toggle

# Linux-only safety: also accept the standard Ctrl+Shift+C/V so muscle
# memory from other Linux terminals still works.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
