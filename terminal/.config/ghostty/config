# Ghostty Configuration for macOS
# https://github.com/ghostty-org/ghostty

# Fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-feature = "-calt"
font-thicken = true

# Window
window-decoration = false
window-padding-x = 10
window-padding-y = 10
window-save-state = always
macos-titlebar-style = hidden

# macOS Integration
macos-option-as-alt = true
macos-window-shadow = true
clipboard-read = allow
clipboard-write = allow

# Shell integration
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

# Colors (Gruvbox Dark)
background = 282828
foreground = ebdbb2
selection-background = ebdbb2
selection-foreground = 655b53

# Palette
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# Keybindings
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
keybind = cmd+t=new_tab
