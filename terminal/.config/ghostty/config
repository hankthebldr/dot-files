# Ghostty — cross-platform config (macOS + Linux/GNOME)
# Theme: GitHub macOS Dark  (per dot-files CLAUDE.md)
# Font:  JetBrainsMono Nerd Font Mono @ 14pt
# Keys:  Mac-style — ⌘/Super for copy/paste/tab/window/find/clear

# ── Font ──────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 11
font-feature = "-calt"
font-thicken = true
# Tight line height for a dense viewport (was +10%, which loosened rows).
adjust-cell-height = 0%

# ── Window ────────────────────────────────────────────────────────────
# Open maximized so the terminal fills the screen on launch — combined with
# the smaller font this gives a dense, repo-wide viewport. `window-save-state`
# is `never` (was `always`) because restoring a stale, undersized geometry was
# what kept the window from opening at full size. Tight padding keeps more
# cells on screen.
maximize = true
window-decoration = false
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = never
window-theme = dark
gtk-titlebar = false
gtk-tabs-location = top
gtk-wide-tabs = false
unfocused-split-opacity = 0.85

# ── macOS-only knobs (ignored on Linux) ───────────────────────────────
macos-titlebar-style = hidden
macos-option-as-alt = true
macos-window-shadow = true

# ── Clipboard ─────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# ── Shell integration ─────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title
mouse-hide-while-typing = true
cursor-style = bar
cursor-style-blink = true

# ── Colors — Gruvbox Material (dark) ──────────────────────────────────
# Soft, low-glare ANSI palette matching `claw theme set gruvbox-material`,
# the p10k prompt, and EZA_COLORS. Apps that color through the terminal's
# 16-color palette (incl. Claude Code's purple directory paths → #d3869b)
# follow this, so the whole terminal reads as one calm gruvbox surface.
background = 1d2021
foreground = d4be98
selection-background = 45403d
selection-foreground = d4be98
cursor-color = d8a657

palette = 0=#282828
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#928374
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#d4be98

# ── Keybindings ───────────────────────────────────────────────────────
# Ghostty's "cmd" binds to ⌘ on macOS and to Super (Win key) on Linux,
# so a single keybind line works on both platforms.

# Clipboard (Mac-style)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+x=copy_to_clipboard

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+w=close_tab
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=last_tab

# Windows & splits
keybind = cmd+n=new_window
keybind = cmd+shift+n=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Misc
keybind = cmd+k=clear_screen
keybind = cmd+f=write_screen_file:paste
keybind = cmd+q=quit
keybind = cmd+comma=open_config
keybind = cmd+shift+r=reload_config

# Linux-only safety: also accept the standard Ctrl+Shift+C/V so muscle
# memory from other Linux terminals still works.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
