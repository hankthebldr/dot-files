# Fires `situation tick` ~every 60s (the freshness/cost balance from the spec:
# the homelab/K3s probes are too expensive to run per-prompt, so a timer keeps a
# cache that every surface reads instantly). Tune the cadence to taste.
[Unit]
Description=Run claw-situation tick every 60s

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
