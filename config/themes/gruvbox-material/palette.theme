# Gruvbox Material (dark, medium) — soft, low-glare earthy palette.
# A warm, desaturated take meant to be easy on the eyes: muted accents over a
# dark brown-grey base, no harsh primaries. Matches the prompt (shell/.p10k.zsh)
# and file-listing colors (EZA_COLORS in shell/exports.zsh), so every surface —
# fzf, dashboard, fastfetch readout, welcome TUI — shares one calm look.
#
# Format: key=hex (no leading '#'). Parsed by scripts/utils/theme.sh (shell) and
# scripts/utils/claw-dashboard.py (python). Single source of truth for the palette.
name=Gruvbox Material
slug=gruvbox-material
bg=1d2021
bg_alt=282828
fg=d4be98
muted=928374
divider=3c3836
blue=7daea3
green=a9b665
purple=d3869b
amber=d8a657
red=ea6962
cyan=89b482
