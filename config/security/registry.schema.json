{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/security/registry.schema.json",
  "title": "Open Claw security tool registry",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/tool" },
  "$defs": {
    "artifact_type": {
      "enum": ["domain", "hostname", "host", "authorized_host", "endpoint", "url",
               "param", "cert", "finding", "secret", "wordlist", "report"]
    },
    "param": {
      "type": "object",
      "required": ["type", "source"],
      "properties": {
        "type": { "enum": ["integer", "number", "string", "boolean", "enum",
                            "artifact", "url", "hostname", "path"] },
        "source": { "enum": ["model", "config", "artifact", "operator"] },
        "of": { "$ref": "#/$defs/artifact_type" },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["description", "binary", "scope_class", "consumes", "emits",
                   "packages", "verify", "expect", "argv", "params", "parser", "timeout"],
      "properties": {
        "description": { "type": "string", "minLength": 40 },
        "binary": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "scope_class": { "enum": ["local", "passive", "active-light", "active", "active-invasive"] },
        "consumes": { "type": "array", "items": { "$ref": "#/$defs/artifact_type" } },
        "emits": { "type": "array", "items": { "$ref": "#/$defs/artifact_type" } },
        "discloses_target": { "type": "boolean" },
        "packages": {
          "type": "object",
          "required": ["kali"],
          "properties": {
            "kali": { "type": "string" },
            "debian": { "type": "string" },
            "darwin": { "type": "string" }
          },
          "additionalProperties": false
        },
        "verify": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "expect": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "items": { "type": "string" } },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/param" } },
        "parser": {
          "type": "string",
          "pattern": "^(jsonl|json|lines|kv|nmap-xml|regex:[a-z0-9_]+|py:[a-z0-9_.]+)$"
        },
        "input_format": {
          "enum": ["lines", "jsonl"],
          "description": "How artifact params reach the tool. 'lines' (default) materializes a plain deduplicated list; 'jsonl' passes the canonical artifact through."
        },
        "taint_fields": { "type": "array", "items": { "type": "string" } },
        "rate": {
          "type": "object",
          "properties": {
            "per_target_rps": { "type": "number", "exclusiveMinimum": 0 },
            "max_concurrency": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "needs_root": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
