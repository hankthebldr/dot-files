{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-ai.txt",
    "type": "file",
    "color": {
      "1": "38;2;188;140;255",
      "2": "38;2;201;209;217",
      "3": "38;2;188;140;255",
      "4": "38;2;139;148;158",
      "5": "38;2;63;185;80",
      "6": "38;2;210;153;34"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;188;140;255",
      "title": "38;2;63;185;80"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os", "key": "  OS" },
    { "type": "host", "key": "  HW" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "gpu", "key": "  GPU" },
    { "type": "disk", "key": "  DSK", "folders": "/" },
    { "type": "localip", "key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── AI Tooling ────────────" },
    {
      "type": "command",
      "key": "  OLLAMA",
      "text": "ollama list 2>/dev/null | tail -n +2 | wc -l | tr -d ' ' | xargs -I{} echo '{} local models' || echo 'not running'"
    },
    {
      "type": "command",
      "key": "  PYTHON",
      "text": "python3 --version 2>/dev/null | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  PIP-PKG",
      "text": "pip3 list 2>/dev/null | tail -n +3 | wc -l | tr -d ' ' | xargs -I{} echo '{} packages' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  CLAUDE",
      "text": "claude --version 2>/dev/null | head -1 || echo 'n/a'"
    },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
