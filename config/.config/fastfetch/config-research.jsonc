{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-research.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;210;153;34",
      "title": "38;2;88;166;255"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " "
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "host",
      "key": "  HW"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "memory",
      "key": "  MEM"
    },
    {
      "type": "disk",
      "key": "  DSK",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "  IP"
    },
    {
      "type": "uptime",
      "key": "  UP"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500 Research Tooling \u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "command",
      "key": "  PYTHON",
      "text": "python3 --version 2>/dev/null | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  JQ",
      "text": "jq --version 2>/dev/null | tr -d 'jq-' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  RG",
      "text": "rg --version 2>/dev/null | head -1 | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "packages",
      "key": "  PKG"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
