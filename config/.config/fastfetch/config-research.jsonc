{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-research.txt",
    "type": "file",
    "color": {
      "1": "38;2;210;153;34",
      "2": "38;2;201;209;217",
      "3": "38;2;210;153;34",
      "4": "38;2;139;148;158",
      "5": "38;2;88;166;255",
      "6": "38;2;63;185;80"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;210;153;34",
      "title": "38;2;88;166;255"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os", "key": "  OS" },
    { "type": "host", "key": "  HW" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "disk", "key": "  DSK", "folders": "/" },
    { "type": "localip", "key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── Research Tooling ──────" },
    {
      "type": "command",
      "key": "  PYTHON",
      "text": "python3 --version 2>/dev/null | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  JQ",
      "text": "jq --version 2>/dev/null | tr -d 'jq-' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  RG",
      "text": "rg --version 2>/dev/null | head -1 | awk '{print $2}' || echo 'n/a'"
    },
    { "type": "packages", "key": "  PKG" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
