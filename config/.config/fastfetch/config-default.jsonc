{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "38;2;88;166;255",
      "title": "38;2;188;140;255"
    },
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name-colored}@{host-name-colored}",
      "key": ""
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r1"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r2"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r3"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r4"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r5"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r6"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r7"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r8"
    },
    {
      "type": "command",
      "key": "",
      "text": "~/.dotfiles/scripts/utils/ff-readout.sh r9"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
