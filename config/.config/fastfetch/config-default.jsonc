{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 0, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;88;166;255",
      "title": "38;2;63;185;80"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}",
      "key": " "
    },
    { "type": "separator", "string": "───────────────────────────────" },
    { "type": "os", "key": "  OS" },
    { "type": "host", "key": "  HW" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "gpu", "key": "  GPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "disk", "key": "  DSK", "folders": "/" },
    { "type": "battery", "key": "  BAT" },
    { "type": "separator", "string": "───────────────────────────────" },
    { "type": "shell", "key": "  SH" },
    { "type": "terminal", "key": "  TERM" },
    { "type": "packages", "key": "  PKG" },
    { "type": "localip", "key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    {
      "type": "command",
      "key": "  DATE",
      "text": "date '+%A, %b %d  %H:%M'"
    },
    { "type": "separator", "string": "───────────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
