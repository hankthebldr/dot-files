{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-default.txt",
    "type": "file",
    "color": {
      "1": "38;2;88;166;255",
      "2": "38;2;188;140;255",
      "3": "38;2;63;185;80",
      "4": "38;2;210;153;34",
      "5": "38;2;88;166;255",
      "6": "38;2;139;148;158"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;88;166;255",
      "title": "38;2;188;140;255"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os", "key": "  OS" },
    { "type": "host", "key": "  HW" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "disk", "key": "  DSK", "folders": "/" },
    { "type": "localip", "key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "shell", "key": "  SH" },
    { "type": "terminal", "key": "  TERM" },
    { "type": "packages", "key": "  PKG" },
    { "type": "battery", "key": "  BAT" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
