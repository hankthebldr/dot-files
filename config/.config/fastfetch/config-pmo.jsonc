{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/pmo/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;176;0",
      "title": "38;2;6;182;212"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "cpu",    "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── PMO ──────────────────" },
    { "type": "command", "key": "  Today",
      "text": "date '+%a %b %d · week %V'" },
    { "type": "command", "key": "  Things",
      "text": "[[ \"$OSTYPE\" == darwin* ]] && osascript -e 'tell application \"Things3\" to count of to dos of list \"Today\"' 2>/dev/null || echo 'n/a on linux'" },
    { "type": "command", "key": "  Inbox",
      "text": "[[ \"$OSTYPE\" == darwin* ]] && osascript -e 'tell application \"Things3\" to count of to dos of list \"Inbox\"' 2>/dev/null || echo 'n/a on linux'" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
