{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/brainstorm/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;0;220",
      "title": "38;2;0;220;255"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "cpu",    "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── Ideation ─────────────" },
    { "type": "command", "key": "  Inbox",
      "text": "find ${OBSIDIAN_VAULT:-$HOME/Obsidian}/00-Inbox -maxdepth 2 -name '*.md' 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "command", "key": "  Mode",
      "text": "echo 'SPARK-CATCHER · vhs'" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
