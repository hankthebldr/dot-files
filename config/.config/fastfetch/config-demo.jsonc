{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/demo/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;46;136",
      "title": "38;2;0;245;255"
    }
  },
  "modules": [
    { "type": "title", "format": "demo@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── Demo Mode ────────────" },
    { "type": "command", "key": "  Status",
      "text": "[[ -f ${DEMO_STATE_FILE:-/tmp/claw-demo-state} ]] && echo 'ENGAGED' || echo 'off'" },
    { "type": "command", "key": "  Assets",
      "text": "ls ${DEMO_ASSETS:-$HOME/Demos}/datasets 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "command", "key": "  Records",
      "text": "ls ${DEMO_ASSETS:-$HOME/Demos}/recordings 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
