{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/homelab/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;0;255;65",
      "title": "38;2;57;255;20"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@bd790i", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "host",   "key": "  HW" },
    { "type": "cpu",    "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "disk",   "key": "  DSK", "folders": "/" },
    { "type": "localip","key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── BD790i Daemons ───────" },
    { "type": "command", "key": "  Tailscale",
      "text": "command -v tailscale >/dev/null && tailscale status --json 2>/dev/null | jq -r '.BackendState' 2>/dev/null || echo 'remote'" },
    { "type": "command", "key": "  Docker",
      "text": "command -v docker >/dev/null && docker ps -q 2>/dev/null | wc -l | tr -d ' ' | xargs -I {} echo '{} containers' || echo 'remote'" },
    { "type": "command", "key": "  K3s",
      "text": "command -v kubectl >/dev/null && kubectl get nodes --no-headers 2>/dev/null | awk '{print $2}' | head -1 || echo 'remote'" },
    { "type": "command", "key": "  Ollama",
      "text": "command -v ollama >/dev/null && ollama list 2>/dev/null | tail -n +2 | wc -l | tr -d ' ' | xargs -I {} echo '{} models' || echo 'remote'" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
