{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/homelab/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;0;255;65",
      "title": "38;2;57;255;20"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@bd790i", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "host",   "key": "  HW" },
    { "type": "cpu",    "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "disk",   "key": "  DSK", "folders": "/" },
    { "type": "localip","key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── HR-TRUST Fleet ───────" },
    { "type": "command", "key": "  Nodes",   "text": "CLAW_BOARD_LABEL=0 ~/.dotfiles/scripts/utils/homelab-board.sh nodes" },
    { "type": "command", "key": "  Cluster", "text": "CLAW_BOARD_LABEL=0 ~/.dotfiles/scripts/utils/homelab-board.sh cluster" },
    { "type": "command", "key": "  DNS",     "text": "CLAW_BOARD_LABEL=0 ~/.dotfiles/scripts/utils/homelab-board.sh dns" },
    { "type": "command", "key": "  Apps",    "text": "CLAW_BOARD_LABEL=0 ~/.dotfiles/scripts/utils/homelab-board.sh apps" },
    { "type": "command", "key": "  Infra",   "text": "CLAW_BOARD_LABEL=0 ~/.dotfiles/scripts/utils/homelab-board.sh infra" },
    { "type": "command", "key": "  Route",   "text": "CLAW_BOARD_LABEL=0 ~/.dotfiles/scripts/utils/homelab-board.sh route" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
