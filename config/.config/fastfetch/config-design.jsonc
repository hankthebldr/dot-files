{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/design/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;0;220",
      "title": "38;2;0;220;255"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "cpu",    "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "separator", "string": "── Design Tooling ───────" },
    { "type": "command", "key": "  mermaid",
      "text": "command -v mmdc >/dev/null && mmdc --version 2>/dev/null | head -1 || echo '(install)'" },
    { "type": "command", "key": "  d2",
      "text": "command -v d2 >/dev/null && d2 --version 2>/dev/null | head -1 || echo '(install)'" },
    { "type": "command", "key": "  IM",
      "text": "command -v convert >/dev/null && convert --version 2>/dev/null | head -1 | awk '{print $2,$3}' || echo '(install)'" },
    { "type": "command", "key": "  Assets",
      "text": "find ${DESIGN_HOME:-$HOME/Design} -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
