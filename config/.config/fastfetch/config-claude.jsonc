{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-claude.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;210;153;34",
      "title": "38;2;88;166;255"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}",
      "key": " "
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "host",
      "key": "  HW"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "memory",
      "key": "  MEM"
    },
    {
      "type": "disk",
      "key": "  DSK",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "  IP"
    },
    {
      "type": "uptime",
      "key": "  UP"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500 Claude Code \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "command",
      "key": "  CLAUDE",
      "text": "claude --version 2>/dev/null | head -1 || echo 'not installed'"
    },
    {
      "type": "command",
      "key": "  NODE",
      "text": "node --version 2>/dev/null || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  PYTHON",
      "text": "python3 --version 2>/dev/null | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  GIT",
      "text": "git config user.name 2>/dev/null || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  MCP",
      "text": "if [ -f \"${XDG_CONFIG_HOME:-$HOME/.config}/claude/claude_desktop_config.json\" ]; then jq '.mcpServers | length' \"${XDG_CONFIG_HOME:-$HOME/.config}/claude/claude_desktop_config.json\" 2>/dev/null | xargs -I{} echo '{} servers'; else echo 'no config'; fi"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
