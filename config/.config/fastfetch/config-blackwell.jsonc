{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/blackwell/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;0;255;65",
      "title": "38;2;57;255;20"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@${BD790I_HOST:-bd790i}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",     "key": "  OS" },
    { "type": "cpu",    "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── Blackwell GPU ────────" },
    { "type": "command", "key": "  GPU",
      "text": "command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo 'remote (use bwgpu)'" },
    { "type": "command", "key": "  VRAM",
      "text": "command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '{printf \"%d / %d MiB\\n\", $1, $2}' || echo 'remote'" },
    { "type": "command", "key": "  Util",
      "text": "command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | xargs -I {} echo '{}%' || echo 'remote'" },
    { "type": "command", "key": "  vLLM",
      "text": "ss -tln 2>/dev/null | grep -q \":${VLLM_PORT:-8000}\" && echo 'serving' || echo 'idle'" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
