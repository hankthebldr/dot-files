{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-security.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;123;114",
      "title": "38;2;188;140;255"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " "
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "host",
      "key": "  HW"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "memory",
      "key": "  MEM"
    },
    {
      "type": "disk",
      "key": "  DSK",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "  IP"
    },
    {
      "type": "uptime",
      "key": "  UP"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500 Security Tooling \u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "command",
      "key": "  NMAP",
      "text": "nmap --version 2>/dev/null | head -1 | awk '{print $3}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  PUB-IP",
      "text": "curl -s --max-time 2 ifconfig.me 2>/dev/null || echo 'offline'"
    },
    {
      "type": "command",
      "key": "  VPN",
      "text": "if command -v scutil >/dev/null; then if scutil --nwi 2>/dev/null | grep -q utun; then echo 'connected'; else echo 'off'; fi; elif ip link show 2>/dev/null | grep -qE 'tun0|wg0'; then echo 'connected'; else echo 'off'; fi"
    },
    {
      "type": "packages",
      "key": "  PKG"
    },
    {
      "type": "battery",
      "key": "  BAT"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
