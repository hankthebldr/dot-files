{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-devops.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;63;185;80",
      "title": "38;2;188;140;255"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " "
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "host",
      "key": "  HW"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "memory",
      "key": "  MEM"
    },
    {
      "type": "disk",
      "key": "  DSK",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "  IP"
    },
    {
      "type": "uptime",
      "key": "  UP"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500 DevOps Tooling \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "command",
      "key": "  DOCKER",
      "text": "echo \"$(docker ps -q 2>/dev/null | wc -l | tr -d ' ') containers running\""
    },
    {
      "type": "command",
      "key": "  K8S",
      "text": "kubectl config current-context 2>/dev/null || echo 'none'"
    },
    {
      "type": "command",
      "key": "  GIT",
      "text": "git --version 2>/dev/null | awk '{print $3}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  TF",
      "text": "terraform --version 2>/dev/null | head -1 | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  ANSIBLE",
      "text": "ansible --version 2>/dev/null | head -1 | awk '{print $2}' | tr -d '[]' || echo 'n/a'"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
