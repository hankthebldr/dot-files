{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-cortex.txt",
    "type": "file",
    "color": {
      "1": "38;2;255;102;0",
      "2": "38;2;201;209;217",
      "3": "38;2;255;102;0",
      "4": "38;2;139;148;158",
      "5": "38;2;255;123;114",
      "6": "38;2;210;153;34"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;102;0",
      "title": "38;2;255;123;114"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os", "key": "  OS" },
    { "type": "host", "key": "  HW" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "memory", "key": "  MEM" },
    { "type": "disk", "key": "  DSK", "folders": "/" },
    { "type": "localip", "key": "  IP" },
    { "type": "uptime", "key": "  UP" },
    { "type": "separator", "string": "── Cortex Tooling ────────" },
    {
      "type": "command",
      "key": "  XSOAR",
      "text": "demisto-sdk --version 2>/dev/null || echo 'not installed'"
    },
    {
      "type": "command",
      "key": "  CORTEX",
      "text": "cortexcli version 2>/dev/null || echo 'not installed'"
    },
    {
      "type": "command",
      "key": "  PYTHON",
      "text": "python3 --version 2>/dev/null | awk '{print $2}' || echo 'n/a'"
    },
    {
      "type": "command",
      "key": "  VPN",
      "text": "if scutil --nwi 2>/dev/null | grep -q utun; then echo 'connected'; else echo 'off'; fi"
    },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
