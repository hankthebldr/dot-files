{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/shell/profiles/vault/logo.txt",
    "type": "file-raw",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;176;0",
      "title": "38;2;0;170;170"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "key": " " },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "os",       "key": "  OS" },
    { "type": "host",     "key": "  HW" },
    { "type": "cpu",      "key": "  CPU" },
    { "type": "memory",   "key": "  MEM" },
    { "type": "disk",     "key": "  DSK", "folders": "/" },
    { "type": "uptime",   "key": "  UP" },
    { "type": "separator", "string": "── Vault ─────────────────" },
    { "type": "command", "key": "  Notes",
      "text": "find ${OBSIDIAN_VAULT:-$HOME/Obsidian} -maxdepth 4 -name '*.md' 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "command", "key": "  Today",
      "text": "date +%Y-%m-%d" },
    { "type": "command", "key": "  Editor",
      "text": "command -v obsidian >/dev/null && echo 'obsidian' || echo '(install obsidian)'" },
    { "type": "separator", "string": "─────────────────────────" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
