{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/config/.config/fastfetch/logo-local.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;63;185;80",
      "title": "38;2;88;166;255"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " "
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "host",
      "key": "  HW"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "memory",
      "key": "  MEM"
    },
    {
      "type": "disk",
      "key": "  DSK",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "  IP"
    },
    {
      "type": "uptime",
      "key": "  UP"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500 Local Tooling \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "shell",
      "key": "  SH"
    },
    {
      "type": "terminal",
      "key": "  TERM"
    },
    {
      "type": "packages",
      "key": "  PKG"
    },
    {
      "type": "battery",
      "key": "  BAT"
    },
    {
      "type": "separator",
      "string": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
