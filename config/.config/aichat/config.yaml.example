# aichat config — Open Claw default
# Symlinked to ~/.config/aichat/config.yaml by scripts/install/openrouter.sh
# Docs: https://github.com/sigoden/aichat/wiki/Configuration-Guide

# Default model used by `aichat` and the `openrouter` wrapper.
# Override at runtime: aichat -m <provider:model>
# Override default:    export CLAW_OPENROUTER_MODEL=openrouter:meta-llama/llama-3.3-70b-instruct
model: openrouter:anthropic/claude-opus-4.7

# Reasonable defaults for terminal use
temperature: 0.3
top_p: null
save_session: false
keybindings: emacs
editor: nvim
wrap: auto
wrap_code: false
highlight: true
light_theme: false

# Providers
clients:
  # OpenRouter — multi-provider gateway
  # API key reads from $OPENROUTER_API_KEY (set in ~/.dotfiles/.env)
  - type: openai-compatible
    name: openrouter
    api_base: https://openrouter.ai/api/v1
    api_key: ${env:OPENROUTER_API_KEY}
    models:
      - name: anthropic/claude-sonnet-4.6
        max_input_tokens: 200000
      - name: anthropic/claude-opus-4.7
        max_input_tokens: 200000
      - name: meta-llama/llama-3.3-70b-instruct
        max_input_tokens: 128000
      - name: deepseek/deepseek-chat
        max_input_tokens: 64000
      - name: google/gemini-2.0-flash-exp
        max_input_tokens: 1000000

  # Local Ollama (Hermes etc.) — uses the OpenAI-compatible endpoint
  - type: openai-compatible
    name: ollama
    api_base: http://localhost:11434/v1
    api_key: ollama
    models:
      - name: hermes3:8b
      - name: hermes3:70b
      - name: nous-hermes2-mixtral

  # Local vLLM on the Blackwell card (enclave-vllm containers, :8000).
  # ALL switchable models are registered here on purpose. Exactly one is live
  # at a time — 24 GB fits one 27B — and which one is chosen by
  # ~/projects/enclave-vllm/switch-model.sh, NOT by this file. Nothing here is
  # set as the aichat default: pick explicitly at runtime so you always know
  # which weights answered you.
  #
  #   aichat -m vllm:qwen3.8-27b-abliterated
  #
  # Asking for a model that is not the live one returns a 404 from vLLM rather
  # than silently answering from the wrong weights. That is the desired failure
  # mode — on 2026-08-28 a boot race left the STOCK model on :8000 while every
  # client believed it was talking to the abliterated one, and the only symptom
  # was unexplained refusals.
  - type: openai-compatible
    name: vllm
    api_base: http://127.0.0.1:8000/v1
    api_key: vllm
    models:
      - name: qwen3.8-27b-abliterated
        max_input_tokens: 62464
      - name: qwen3.8-27b
        max_input_tokens: 62464
      - name: qwen3.6-27b
        max_input_tokens: 38912
