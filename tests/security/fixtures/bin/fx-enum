#!/usr/bin/env python3
"""Passive enumeration stand-in: domain rows -> hostname rows.

Deliberately returns one host that is NOT in the lab scope, because that is
the case the gate exists for.
"""
import json, sys
if "-version" in sys.argv:
    print("fx-enum v1.0 projectdiscovery"); sys.exit(0)
path = sys.argv[sys.argv.index("-list") + 1]
for line in open(path):
    line = line.strip()
    if not line:
        continue
    row = json.loads(line)
    domain = row.get("domain") or row.get("host") or row.get("value")
    for sub in ("web", "api", "old"):
        print(json.dumps({"host": f"{sub}.{domain}", "source": "certspotter"}))
    print(json.dumps({"host": "leaked-asset.example.org", "source": "certspotter"}))
