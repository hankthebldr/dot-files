[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

[user]
    name = Henry Reed
    email = Henry.reed@icloud.com

[core]
    editor = vim
    excludesfile = ~/.gitignore_global
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = claw-dark
    navigate = true
    light = false

[delta "claw-dark"]
    side-by-side = true
    line-numbers = true
    hyperlinks = true
    syntax-theme = gruvbox-dark
    wrap-max-lines = 2
    file-style = "#58a6ff" bold
    file-decoration-style = "#30363d" ul
    line-numbers-minus-style = "#ff7b72"
    line-numbers-plus-style = "#3fb950"
    line-numbers-zero-style = "#6e7681"

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[init]
    defaultBranch = master

[pull]
    rebase = true

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
