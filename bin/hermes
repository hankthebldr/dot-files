#!/usr/bin/env bash
# hermes — local Hermes agent via Ollama
#
# Usage:
#   hermes                    # interactive REPL
#   hermes "your prompt"      # one-shot inference
#
# Model is configurable: export CLAW_HERMES_MODEL=hermes3:70b
# Defaults to hermes3:8b (~5GB, runs comfortably on CPU).

set -e

MODEL="${CLAW_HERMES_MODEL:-hermes3:8b}"

# Ensure ollama is on PATH
if ! command -v ollama &>/dev/null; then
    echo "hermes: ollama not installed" >&2
    echo "        run: claw install ai   (or: bash \$DOTFILES_DIR/scripts/install/hermes.sh)" >&2
    exit 1
fi

# Parse a leading --serve flag (auto-start the daemon instead of just instructing)
SERVE=0
if [[ "${1:-}" == "--serve" ]]; then SERVE=1; shift; fi

# Resolve repo + source the shared ollama helper + OS detection.
# `detect_os || true` guards against set -e aborting on an unrecognized OS;
# OS_TYPE is only used to prefer `brew services` on macOS.
DOTFILES="${DOTFILES_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
source "$DOTFILES/scripts/utils/detect-os.sh"; detect_os || true
source "$DOTFILES/scripts/utils/ollama.sh"

# Ensure the daemon is reachable
if ! ollama_up; then
    if (( SERVE )); then
        ollama_ensure_up || { echo "hermes: could not start ollama daemon" >&2; exit 1; }
    else
        echo "hermes: ollama daemon not reachable at :11434" >&2
        echo "        auto-start it:  claw hermes --serve   (or: hermes --serve)" >&2
        exit 1
    fi
fi

# Verify model is pulled
if ! ollama list 2>/dev/null | awk 'NR>1 {print $1}' | grep -Fxq "$MODEL"; then
    echo "hermes: model not pulled: $MODEL" >&2
    echo "        run: ollama pull $MODEL   (or: claw install ai)" >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    exec ollama run "$MODEL"
else
    exec ollama run "$MODEL" "$*"
fi
