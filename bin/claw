cmd_skills() {
    local skills_dir="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
    if [[ ! -d "$skills_dir" ]]; then
        err "skills directory not found: $skills_dir"
        info "set CLAUDE_SKILLS_DIR or install Claude skills"
        return 1
    fi
    if ! command -v fzf &>/dev/null; then
        err "fzf not installed"; return 1
    fi
    local picked
    # -L follows symlinks (skills are typically symlinked from .agents/skills)
    picked=$(find -L "$skills_dir" -maxdepth 3 -name 'SKILL.md' 2>/dev/null | \
        sed "s|$skills_dir/||; s|/SKILL.md||" | \
        fzf --prompt="skill ▶ " --height=~30 --reverse \
            --preview="cat $skills_dir/{}/SKILL.md 2>/dev/null | head -60" \
            --color="bg+:#161b22,fg+:#c9d1d9,prompt:#bc8cff,header:#8b949e,pointer:#3fb950") || return 0
    [[ -z "$picked" ]] && return 0
    if command -v glow &>/dev/null; then
        glow "$skills_dir/$picked/SKILL.md"
    else
        less "$skills_dir/$picked/SKILL.md"
    fi
}

cmd_load() {
    local p="$1"
    [[ -z "$p" ]] && { err "usage: claw load <profile>"; return 1; }
    local pfile="$DOTFILES/shell/profiles/$p.zsh"
    [[ ! -f "$pfile" ]] && { err "profile not found: $p"; info "available: $(cd "$DOTFILES/shell/profiles" 2>/dev/null && ls *.zsh 2>/dev/null | sed 's/\.zsh$//' | tr '\n' ' ')"; return 1; }
    # NOTE: this branch is normally shadowed by the `claw()` zsh function in
    # shell/claw-fn.zsh, which sources the profile in the parent shell. We
    # only reach here if claw is invoked as `bash bin/claw load` or from a
    # non-zsh shell — then we can't mutate the caller, so print instructions.
    info "shell function not loaded — to load in your current shell:"
    printf "    ${c_white}export CLAW_ACTIVE_PROFILE=%s && source %s${c_reset}\n" "$p" "$pfile"
    info "(or just open a new zsh shell so the claw() function is available)"
}

cmd_off() {
    # Same caveat as cmd_load — normally handled by shell/claw-fn.zsh.
    info "shell function not loaded — to unload in your current shell:"
    printf "    ${c_white}unset CLAW_ACTIVE_PROFILE && exec zsh${c_reset}\n"
}

cmd_restore_shell() {
    # Re-link the shell dotfiles (~/.zshrc, ~/.p10k.zsh, …) back to the repo.
    # Use after `p10k configure` (or any tool) replaces a stow symlink with a
    # plain file — that's what drops the fastfetch/profile/prompt work.
    if ! command -v stow &>/dev/null; then
        err "GNU stow not installed — install it first: brew install stow"
        return 1
    fi
    # Lift any immutable lock (claw lock-shell) first — stow -R can't remove a
    # locked symlink. No-op when nothing is locked.
    if [[ "$(uname -s)" == "Darwin" ]]; then
        chflags -h nouchg "$HOME/.zshrc" "$HOME/.p10k.zsh" 2>/dev/null || true
    else
        sudo chattr -i "$HOME/.zshrc" "$HOME/.p10k.zsh" 2>/dev/null || true
    fi
    local ts backup
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="$HOME/.dotfiles-backups/$ts"
    info "restoring shell symlinks from ${c_white}$DOTFILES/shell${c_reset}"

    # Move aside any real files squatting on the symlink targets (stow refuses to
    # overwrite files it doesn't own). Symlinks are left for stow to refresh.
    mkdir -p "$backup"
    local f name
    for f in "$DOTFILES"/shell/.[a-z]*; do
        name="$(basename "$f")"
        local target="$HOME/$name"
        if [[ -e "$target" && ! -L "$target" ]]; then
            mv "$target" "$backup/$name"
            info "backed up real $name → ${c_dim}$backup/$name${c_reset}"
        fi
    done

    if stow -R -d "$DOTFILES" -t "$HOME" shell 2>/dev/null; then
        ok "shell module relinked"
    else
        err "stow reported a conflict — inspect: stow -nv -d $DOTFILES -t $HOME shell"
        return 1
    fi
    # Sweep up vanilla per-profile prompt files left by an old `p10k configure`
    # (not in the repo, no longer sourced) so they can't shadow the tuned theme.
    local pf
    for pf in "$HOME"/.p10k-*.zsh; do
        [[ -e "$pf" ]] || continue
        mv "$pf" "$backup/" && info "archived stray $(basename "$pf") → ${c_dim}$backup/${c_reset}"
    done
    printf "    ${c_white}exec zsh${c_reset}  ${c_dim}# reload to pick up the restored prompt${c_reset}\n"
}

# Shell stow symlinks that `p10k configure` likes to clobber. Locking them makes
# the wizard physically unable to replace them; the THEME stays editable because
# the flag is on the symlink, not the repo file it points at.
_claw_shell_links=("$HOME/.zshrc" "$HOME/.p10k.zsh")

cmd_lock_shell() {
    local link rc=0
    if [[ "$(uname -s)" == "Darwin" ]]; then
        for link in "${_claw_shell_links[@]}"; do
            [[ -e "$link" ]] || continue
            if chflags -h uchg "$link" 2>/dev/null; then
                ok "locked ${c_white}$link${c_reset}"
            else
                err "could not lock $link"; rc=1
            fi
        done
        info "theme stays editable: ${c_white}\$DOTFILES_DIR/shell/.p10k.zsh${c_reset} then ${c_white}exec zsh${c_reset}"
        info "to re-stow or run the wizard, first ${c_white}claw unlock-shell${c_reset}"
    else
        for link in "${_claw_shell_links[@]}"; do
            [[ -e "$link" ]] || continue
            if sudo chattr +i "$link" 2>/dev/null; then
                ok "locked $link ${c_dim}(chattr +i)${c_reset}"
            else
                err "could not lock $link — needs root + an fs that supports chattr +i"; rc=1
            fi
        done
    fi
    return $rc
}

cmd_unlock_shell() {
    local link
    if [[ "$(uname -s)" == "Darwin" ]]; then
        for link in "${_claw_shell_links[@]}"; do
            [[ -e "$link" ]] || continue
            chflags -h nouchg "$link" 2>/dev/null && ok "unlocked ${c_white}$link${c_reset}"
        done
    else
        for link in "${_claw_shell_links[@]}"; do
            [[ -e "$link" ]] || continue
            sudo chattr -i "$link" 2>/dev/null && ok "unlocked $link"
        done
    fi
}

cmd_install() {
    local tc="$1"
    [[ -z "$tc" ]] && { err "usage: claw install <toolchain> [-- extra-args]"; info "options: nextgen cloud security devops ai ai-workstation ai-skills research cortex homelab deck demo design"; return 1; }
    local script="$DOTFILES/scripts/install/${tc}-toolchain.sh"
    [[ ! -f "$script" ]] && { err "toolchain not found: $tc ($script)"; return 1; }
    shift
    info "running $script (this can take a while)"
    DOTFILES_DIR="$DOTFILES" bash "$script" "$@"
}

cmd_profiles() {
    case "${1:-}" in
        lint) DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/profiles-lint.sh" ;;
        paths|dirs|start)
            # Every profile's PROFILE_START_DIR → where it resolves on THIS
            # machine. Rendered by the same zsh resolver the load paths use
            # (shell/profile-helpers.zsh) — never a second implementation.
            if ! command -v zsh &>/dev/null; then
                err "zsh required to resolve profile start dirs"; return 1
            fi
            DOTFILES_DIR="$DOTFILES" zsh -c \
                'source "$DOTFILES_DIR/shell/profile-helpers.zsh"; _claw_profile_paths'
            ;;
        *)    err "usage: claw profiles {lint|paths}"; return 1 ;;
    esac
}

cmd_theme() {
    # Single-source-of-truth color switcher. list | current | set | preview | fzf | build | apply.
    local sub="${1:-list}"; shift || true
    case "$sub" in
        ""|list|ls)        DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" list ;;
        current|active)    DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" current ;;
        set|use)           DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" set "$@" ;;
        preview|show)      DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" preview "$@" ;;
        fzf)               DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" fzf ;;
        build)             DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" build ;;
        apply)             DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/theme.sh" apply ;;
        help|-h|--help)
            cat <<EOF
  ${c_purple}${c_bold}claw theme${c_reset} — Open Claw color palette switcher

  ${c_white}claw theme${c_reset}                  ${c_dim}list palettes (● = active)${c_reset}
  ${c_white}claw theme current${c_reset}          ${c_dim}print the active palette slug${c_reset}
  ${c_white}claw theme preview [slug]${c_reset}   ${c_dim}show color swatches${c_reset}
  ${c_white}claw theme set <slug>${c_reset}       ${c_dim}switch palette (then: exec zsh)${c_reset}
  ${c_white}claw theme build${c_reset}            ${c_dim}rebuild every theme's library artifacts (ghostty.conf)${c_reset}
  ${c_white}claw theme apply${c_reset}            ${c_dim}re-point Ghostty at the active theme's colors${c_reset}

  ${c_dim}Palettes: refined-dark (default) · github-dark · catppuccin-mocha · tokyo-night · rose-pine · gruvbox-material${c_reset}
  ${c_dim}Each theme is a library: ${DOTFILES}/config/themes/<slug>/ (palette.theme + ghostty.conf).${c_reset}
EOF
            ;;
        *) err "unknown theme subcommand: $sub"; info "try: claw theme help"; return 1 ;;
    esac
}

cmd_gpu() {
    # Server-side K3s GPU enablement (apply device plugin, label/taint, verify).
    DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/k3s-gpu-enable.sh" "$@"
}

cmd_gateway() {
    # OpenShell gateway management (check | register | status | sandbox | deploy-cluster).
    DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/openshell-gateway.sh" "$@"
}

cmd_uninstall() {
    # Soft uninstall — reverses bootstrap deployment without removing
    # CLI packages, OMZ, P10k, or fonts. See scripts/utils/uninstall.sh
    # header for full scope. Flags: --dry-run --yes --keep-backup --help
    bash "$DOTFILES/scripts/utils/uninstall.sh" "$@"
}

cmd_claude() {
    local sub="${1:-help}"; shift || true
    case "$sub" in
        snapshot)
            DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/claude-snapshot.sh" "$@"
            ;;
        sync)
            DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/install/claude-sync.sh" "$@"
            ;;
        status)
            local mdir="$DOTFILES/claude/manifests"
            if [[ ! -d "$mdir" ]]; then
                err "no manifests yet — run: claw claude snapshot"; return 1
            fi
            printf "\n  ${c_purple}${c_bold}claude state${c_reset}  ${c_dim}vs ${mdir}${c_reset}\n\n"
            if [[ -f "$mdir/SNAPSHOT.json" ]] && command -v jq &>/dev/null; then
                info "last snapshot: ${c_dim}$(jq -r '.snapshotAt' "$mdir/SNAPSHOT.json") on $(jq -r '.hostname' "$mdir/SNAPSHOT.json")${c_reset}"
            fi
            local m_plugins live_plugins
            m_plugins=$(wc -l < "$mdir/plugins.txt" 2>/dev/null | tr -d ' ' || echo 0)
            # grep -c already emits 0 on no match; the old `|| echo 0` appended a
            # SECOND 0 when claude was absent (grep exits 1 on empty input), giving
            # live_plugins=$'0\n0' → the (( )) compare errored and fell to "in sync".
            if command -v claude &>/dev/null; then
                live_plugins=$(claude plugin list 2>/dev/null | grep -c '❯ .*@')
            else
                live_plugins=0
            fi
            info "plugins: ${c_white}$live_plugins${c_reset} live · ${c_white}$m_plugins${c_reset} in manifest"
            if (( m_plugins != live_plugins )); then
                err "drift detected — run claw claude-sync snapshot (or sync)"
            else
                ok "in sync"
            fi
            echo ""
            ;;
        help|-h|--help|"")
            cat <<EOF
  ${c_purple}${c_bold}claw claude-sync${c_reset} — sync Claude Code state across machines  ${c_dim}(alias: csync)${c_reset}

  ${c_white}claw claude-sync snapshot${c_reset}  ${c_dim}capture this machine's plugins/skills/marketplaces${c_reset}
  ${c_white}claw claude-sync sync${c_reset}      ${c_dim}install everything from the manifest on this machine${c_reset}
  ${c_white}claw claude-sync status${c_reset}    ${c_dim}diff live state vs manifest${c_reset}

  ${c_dim}Env overrides for sync:${c_reset}
    ${c_dim}CLAUDE_SYNC_DRY_RUN=1${c_reset}  ${c_dim}print actions only${c_reset}
    ${c_dim}CLAUDE_SYNC_FORCE=1${c_reset}    ${c_dim}reinstall even if already present${c_reset}

  ${c_dim}Manifests live in ${DOTFILES}/claude/manifests/${c_reset}
  ${c_dim}Workflow: snapshot on Mac → commit → git pull on BD790i → sync${c_reset}
EOF
            ;;
        *)
            err "unknown claude subcommand: $sub"
            info "try: claw claude help"
            return 1
            ;;
    esac
}

cmd_agent() {
    local sub="$1"; shift || true
    case "$sub" in
        list)
            ensure_agents_toml
            printf "\n  ${c_purple}${c_bold}registered agents${c_reset}  ${c_dim}(%s)${c_reset}\n\n" "$AGENTS_TOML"
            local name cmd profile desc
            for name in $(agent_list_sections); do
                cmd=$(agent_get "$name" command)
                profile=$(agent_get "$name" profile)
                desc=$(agent_get "$name" description)
                printf "  ${c_green}●${c_reset} ${c_white}${c_bold}%-12s${c_reset} ${c_dim}→ %s${c_reset}" "$name" "$cmd"
                [[ -n "$profile" ]] && printf "  ${c_dim}[profile: %s]${c_reset}" "$profile"
                printf "\n"
                [[ -n "$desc" ]] && printf "    ${c_dim}%s${c_reset}\n" "$desc"
            done
            echo ""
            ;;
        add)
            local name="$1" command="$2" profile="$3"
            [[ -z "$name" || -z "$command" ]] && { err "usage: claw agent add <name> <command> [profile]"; return 1; }
            ensure_agents_toml
            if grep -q "^\[$name\]$" "$AGENTS_TOML"; then
                err "agent already registered: $name (edit $AGENTS_TOML manually to change)"; return 1
            fi
            {
                printf '\n[%s]\n' "$name"
                printf 'command = "%s"\n' "$command"
                [[ -n "$profile" ]] && printf 'profile = "%s"\n' "$profile"
            } >> "$AGENTS_TOML"
            ok "registered agent: $name → $command"
            ;;
        doctor)
            ensure_agents_toml
            printf "\n  ${c_purple}${c_bold}agent health${c_reset}\n\n"
            local name cmd
            for name in $(agent_list_sections); do
                cmd=$(agent_get "$name" command)
                # binary present?
                if command -v "${cmd%% *}" &>/dev/null; then
                    printf "  ${c_green}●${c_reset} ${c_white}%-12s${c_reset} ${c_dim}%s${c_reset}" "$name" "$cmd"
                else
                    printf "  ${c_red}○${c_reset} ${c_white}%-12s${c_reset} ${c_dim}%s — not installed${c_reset}" "$name" "$cmd"
                fi
                # key present? (map agent → expected env var)
                local keyvar=""
                case "$name" in
                    claude)     keyvar=ANTHROPIC_API_KEY ;;
                    gemini)     keyvar=GEMINI_API_KEY ;;
                    openrouter) keyvar=OPENROUTER_API_KEY ;;
                    *)          keyvar="" ;;
                esac
                if [[ -n "$keyvar" ]]; then
                    [[ -n "${!keyvar:-}" ]] \
                        && printf "  ${c_green}key✓${c_reset}" || printf "  ${c_orange}key?${c_reset}"
                fi
                printf "\n"
            done
            printf "\n  ${c_dim}MCP: claw agent mcp-sync --dry-run · keys: .env / claw secret env${c_reset}\n\n"
            ;;
        mcp-sync)
            python3 "$DOTFILES/scripts/utils/mcp-sync.py" "$@"
            ;;
        *)
            err "unknown agent subcommand: $sub"
            info "try: claw agent {list|add|doctor|mcp-sync}"
            return 1
            ;;
    esac
}

cmd_run_agent() {
    local agent="$1"; shift || true
    ensure_agents_toml
    local cmd profile args
    cmd=$(agent_get "$agent" command)
    profile=$(agent_get "$agent" profile)
    args=$(agent_get "$agent" args)
    if [[ -z "$cmd" ]]; then
        err "unknown subcommand or agent: $agent"
        info "try: claw help  |  claw agent list"
        return 1
    fi
    if ! command -v "$cmd" &>/dev/null; then
        err "agent binary not on PATH: $cmd"
        info "install it, or update [$agent] in $AGENTS_TOML"
        return 1
    fi
    # Optionally render the profile dashboard before launch
    if [[ -n "$profile" ]]; then
        local ff_config="$DOTFILES/config/.config/fastfetch/config-$profile.jsonc"
        if command -v fastfetch &>/dev/null && [[ -f "$ff_config" ]]; then
            fastfetch -c "$ff_config" 2>/dev/null || true
            echo ""
        fi
    fi
    # Hand off — exec replaces claw with the agent. If the caller passed no args
    # and the agent declares default `args`, use those (e.g. openwork → `openwork
    # start`); any explicit args always win and are forwarded verbatim.
    if [[ $# -eq 0 && -n "$args" ]]; then
        # shellcheck disable=SC2086  # deliberate word-split of registry args
        exec "$cmd" $args
    fi
    exec "$cmd" "$@"
}

