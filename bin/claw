#!/usr/bin/env bash
# claw — single entry point for Open Claw dotfiles
# Routes to skills, MCP, homelab, tunnels, agents, profiles, updates
#
# Usage: claw [subcommand] [args...]
# Run `claw help` for the full list.

set -e

DOTFILES="${DOTFILES_DIR:-$HOME/.dotfiles}"
CLAW_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claw"
AGENTS_TOML="$CLAW_CONFIG_DIR/agents.toml"
CLAW_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claw"
CLAW_USAGE_LOG="$CLAW_CACHE_DIR/usage.tsv"

# ============================================
# THEME — from the active Open Claw palette (theme.sh single source of truth).
# Sourcing exports CLAW_RGB_*; fallbacks are refined-dark so claw renders
# correctly even if theme.sh is missing (e.g. mid-bootstrap).
# ============================================
# shellcheck source=/dev/null
[ -r "$DOTFILES/scripts/utils/theme.sh" ] && . "$DOTFILES/scripts/utils/theme.sh" 2>/dev/null || true
c_reset=$'\e[0m'
c_cyan=$'\e[38;2;'"${CLAW_RGB_BLUE:-88;166;255}"$'m'
c_green=$'\e[38;2;'"${CLAW_RGB_GREEN:-63;185;80}"$'m'
c_purple=$'\e[38;2;'"${CLAW_RGB_PURPLE:-188;140;255}"$'m'
c_orange=$'\e[38;2;'"${CLAW_RGB_AMBER:-227;179;65}"$'m'
c_red=$'\e[38;2;'"${CLAW_RGB_RED:-255;123;114}"$'m'
c_dim=$'\e[38;2;'"${CLAW_RGB_MUTED:-139;148;158}"$'m'
c_white=$'\e[38;2;'"${CLAW_RGB_FG:-201;209;217}"$'m'
c_bold=$'\e[1m'

err()  { printf "  ${c_red}✗${c_reset} %s\n" "$*" >&2; }
info() { printf "  ${c_cyan}●${c_reset} %s\n" "$*"; }
ok()   { printf "  ${c_green}✓${c_reset} %s\n" "$*"; }

# ============================================
# USAGE LOGGER
# ============================================
# Append-only TSV: ISO timestamp \t subcommand \t arg-count \t profile
# Disable with CLAW_NO_LOG=1. Errors are swallowed — must never block dispatch.
log_usage() {
    [[ "$CLAW_NO_LOG" = "1" ]] && return 0
    {
        mkdir -p "$CLAW_CACHE_DIR" 2>/dev/null
        printf '%s\t%s\t%s\t%s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            "${1:-menu}" \
            "$(( $# > 0 ? $# - 1 : 0 ))" \
            "${CLAW_ACTIVE_PROFILE:-none}" \
            >> "$CLAW_USAGE_LOG"
    } 2>/dev/null || true
}

# ============================================
# AGENTS REGISTRY
# ============================================
ensure_agents_toml() {
    if [[ ! -f "$AGENTS_TOML" ]]; then
        mkdir -p "$CLAW_CONFIG_DIR"
        cat > "$AGENTS_TOML" <<'EOF'
# Open Claw agent registry
# Add an entry per coding/AI agent you use. `claw <name>` launches it.
# Keys: command (required), profile (optional), description (optional)

[claude]
command = "claude"
profile = "claude"
description = "Anthropic Claude Code"

[gemini]
command = "gemini"
profile = "ai"
description = "Google Gemini CLI (@google/gemini-cli)"

[hermes]
command = "hermes"
profile = "ai"
kind = "local"
description = "Hermes 3 local agent (Ollama)"

[openrouter]
command = "openrouter"
profile = "ai"
kind = "chat"
description = "OpenRouter via aichat"

[aichat]
command = "aichat"
profile = "ai"
kind = "chat"
description = "Multi-provider chat/pipe"
EOF
        info "Created $AGENTS_TOML with [claude] pre-registered"
    fi
}

# Parse a single key from a [section] of agents.toml.
# Usage: agent_get <section> <key>
agent_get() {
    local section="$1" key="$2"
    awk -v s="[$section]" -v k="$key" '
        $0 == s        { in_section = 1; next }
        /^\[/          { in_section = 0 }
        in_section && $1 == k && $2 == "=" {
            $1 = $2 = ""
            sub(/^[ \t]+/, "")
            gsub(/^"|"$/, "")
            print
            exit
        }
    ' "$AGENTS_TOML" 2>/dev/null
}

# List all agent section names.
agent_list_sections() {
    awk '/^\[[a-zA-Z0-9_-]+\]$/ { gsub(/^\[|\]$/, ""); print }' "$AGENTS_TOML" 2>/dev/null
}

# ============================================
# SUBCOMMANDS
# ============================================

cmd_help() {
    cat <<EOF
  ${c_purple}${c_bold}claw${c_reset} — ${c_dim}Open Claw dispatcher${c_reset}

  ${c_cyan}${c_bold}Workflows${c_reset}
    ${c_white}claw${c_reset}                  ${c_dim}open the welcome menu (FZF)${c_reset}
    ${c_white}claw doctor${c_reset}           ${c_dim}system + active-profile health${c_reset}
    ${c_white}claw situation${c_reset}        ${c_dim}fleet/system awareness snapshot (show|probe|tick|alerts|install)${c_reset}
    ${c_white}claw restore-shell${c_reset}    ${c_dim}re-link ~/.zshrc, ~/.p10k.zsh, … to the repo (fix clobbered symlinks)${c_reset}
    ${c_white}claw lock-shell${c_reset}       ${c_dim}make ~/.zshrc & ~/.p10k.zsh immutable so p10k configure can't clobber them${c_reset}
    ${c_white}claw unlock-shell${c_reset}     ${c_dim}lift the immutable lock (before re-stow / running the wizard)${c_reset}
    ${c_white}claw storage${c_reset}          ${c_dim}storage usage analysis + offload candidates (storage-doctor)${c_reset}
    ${c_white}claw validate${c_reset}         ${c_dim}full top-to-bottom install check + update/missing detection${c_reset}
    ${c_white}claw stats${c_reset}            ${c_dim}your claw usage breakdown${c_reset}
    ${c_white}claw tui-stats${c_reset}        ${c_dim}welcome-TUI fire/pick breakdown${c_reset}
    ${c_white}claw update${c_reset}           ${c_dim}full system update (brew/npm/pip/etc); ${c_white}--tools${c_dim} curated CLI refresh, ${c_white}--schedule${c_dim} weekly timer · alias: ${c_white}claw upgrade${c_reset}
    ${c_white}claw output${c_reset}           ${c_dim}display settings: mode auto|rich|plain · frame viewfinder|none · banner on|off${c_reset}

  ${c_green}${c_bold}TUIs${c_reset}
    ${c_white}claw tun${c_reset}              ${c_dim}SSH tunnel manager${c_reset}
    ${c_white}claw mcp${c_reset}              ${c_dim}MCP server manager${c_reset}
    ${c_white}claw homelab${c_reset}          ${c_dim}homelab SSH topology${c_reset}
    ${c_white}claw toolkit${c_reset}          ${c_dim}Open Claw workflow launcher${c_reset}
    ${c_white}claw ai-services${c_reset}      ${c_dim}self-hosted AI/web stacks: open-webui|dify|ragflow|langfuse|portainer${c_reset}
    ${c_white}claw docker${c_reset}           ${c_dim}grouped overview of all containers (lzd=tui, cto=metrics)${c_reset}
    ${c_white}claw skills${c_reset}           ${c_dim}browse Claude skills${c_reset}
    ${c_white}claw obsidian${c_reset}         ${c_dim}vault helpers (profile-aware)${c_reset}
    ${c_white}claw onboard${c_reset}          ${c_dim}80s arcade onboarding · picks your profile${c_reset}
    ${c_white}claw integrity${c_reset}        ${c_dim}tamper-check + install verification${c_reset}

  ${c_orange}${c_bold}Profiles${c_reset}
    ${c_white}claw load <profile>${c_reset}   ${c_dim}source a profile in current shell${c_reset}
    ${c_white}claw off${c_reset}              ${c_dim}unset active profile${c_reset}

  ${c_purple}${c_bold}Agents${c_reset}
    ${c_white}claw <agent>${c_reset}          ${c_dim}launch a registered agent (claude, hermes, …)${c_reset}
    ${c_white}claw agent list${c_reset}       ${c_dim}list registered agents${c_reset}
    ${c_white}claw agent add${c_reset}        ${c_dim}claw agent add <name> <command> [profile]${c_reset}
    ${c_white}claw agent doctor${c_reset}     ${c_dim}per-agent binary + key + config health${c_reset}
    ${c_white}claw mcp-sync${c_reset}          ${c_dim}render one MCP registry → Claude Code/Gemini/Desktop${c_reset}
    ${c_white}claw ai <cmd>${c_reset}          ${c_dim}local stack: serve|models|pull|chat|web|doctor${c_reset}

  ${c_green}${c_bold}AI Workstation${c_reset}
    ${c_white}claw gpu [--test --taint]${c_reset}  ${c_dim}K3s GPU node enablement (run on the server)${c_reset}
    ${c_white}claw gateway <cmd>${c_reset}         ${c_dim}OpenShell gateway: check|register|status|sandbox${c_reset}

  ${c_red}${c_bold}Install${c_reset}
    ${c_white}claw install <toolchain>${c_reset}  ${c_dim}opt-in toolchain installer (cloud/security/…)${c_reset}
    ${c_white}claw provision${c_reset}            ${c_dim}fresh box → fully configured in one pass (--dry-run --minimal)${c_reset}
    ${c_white}claw pkg {list|scan|track|install|update}${c_reset} ${c_dim}self-aware tool registry${c_reset}
    ${c_white}claw uninstall${c_reset}            ${c_dim}reverse bootstrap (soft scope · --dry-run --yes)${c_reset}
    ${c_white}claw claude-sync snapshot${c_reset} ${c_dim}capture Mac Claude state → manifests${c_reset}
    ${c_white}claw claude-sync sync${c_reset}     ${c_dim}replay manifests on this machine (BD790i etc.)${c_reset}
    ${c_white}claw claude-sync status${c_reset}   ${c_dim}diff live state vs manifests · (alias: csync)${c_reset}

  ${c_purple}${c_bold}Knowledge & Secrets${c_reset}
    ${c_white}claw harness <cmd>${c_reset}      ${c_dim}custom agentic skills: list|new <name>|deploy|path${c_reset}
    ${c_white}claw handoff "topic"${c_reset}   ${c_dim}session note → Obsidian 00-Inbox (backlinked)${c_reset}
    ${c_white}claw docs-sync${c_reset}         ${c_dim}sync repo docs → Obsidian vault${c_reset}
    ${c_white}claw capture-tasks${c_reset}     ${c_dim}vault '@things' lines → Things 3 tasks${c_reset}
    ${c_white}claw secret <cmd>${c_reset}      ${c_dim}init|env|encrypt|decrypt|doctor (age+sops)${c_reset}
    ${c_white}claw selfupdate install${c_reset} ${c_dim}schedule weekly auto-update${c_reset}
    ${c_white}claw cheatsheet${c_reset}        ${c_dim}one-screen command reference${c_reset}
    ${c_white}claw theme [set <name>]${c_reset} ${c_dim}switch color palette (refined-dark · catppuccin · tokyo-night · …)${c_reset}

  ${c_dim}Config: ${AGENTS_TOML}${c_reset}
EOF
}

cmd_menu() {
    # Source the welcome TUI in a child zsh so the FZF menu can drive everything
    # exactly as it does on shell login.
    zsh -i -c 'source "$DOTFILES_DIR/shell/welcome-tui.zsh" && claw_welcome_tui' 2>/dev/null || \
        err "welcome-tui failed — try: source \$DOTFILES_DIR/shell/welcome-tui.zsh && claw_welcome_tui"
}

cmd_stats() {
    if [[ ! -s "$CLAW_USAGE_LOG" ]]; then
        info "no usage logged yet ${c_dim}($CLAW_USAGE_LOG)${c_reset}"
        info "use claw normally for a few days, then re-run claw stats"
        return 0
    fi
    local total since
    total=$(wc -l < "$CLAW_USAGE_LOG" | tr -d ' ')
    since=$(head -1 "$CLAW_USAGE_LOG" | cut -f1)
    printf "\n  ${c_purple}${c_bold}claw stats${c_reset}  ${c_dim}— %s invocations since %s${c_reset}\n" "$total" "$since"
    printf "  ${c_dim}─────────────────────────────────────${c_reset}\n\n"
    printf "  ${c_cyan}${c_bold}By subcommand${c_reset}\n"
    cut -f2 "$CLAW_USAGE_LOG" | sort | uniq -c | sort -rn | \
        awk -v g=$'\e[38;2;63;185;80m' -v d=$'\e[38;2;139;148;158m' -v r=$'\e[0m' \
            '{ printf "    %s%4d%s  %s%s%s\n", g, $1, r, d, $2, r }'
    printf "\n  ${c_cyan}${c_bold}By profile${c_reset}\n"
    cut -f4 "$CLAW_USAGE_LOG" | sort | uniq -c | sort -rn | \
        awk -v g=$'\e[38;2;188;140;255m' -v d=$'\e[38;2;139;148;158m' -v r=$'\e[0m' \
            '{ printf "    %s%4d%s  %s%s%s\n", g, $1, r, d, $2, r }'
    printf "\n  ${c_dim}log: %s${c_reset}\n\n" "$CLAW_USAGE_LOG"
}

cmd_tui_stats() {
    if [[ ! -s "$CLAW_USAGE_LOG" ]]; then
        info "no usage logged yet ${c_dim}($CLAW_USAGE_LOG)${c_reset}"
        info "open a few fresh shells, then re-run claw tui-stats"
        return 0
    fi

    # Pull TUI events only. Schema: timestamp \t event \t arg_count \t profile
    local tui_rows fires esc_fallbacks skip_picks
    tui_rows=$(awk -F'\t' '$2 ~ /^tui:/' "$CLAW_USAGE_LOG")
    if [[ -z "$tui_rows" ]]; then
        info "TUI has not fired yet since instrumentation landed"
        info "log a few logins, then re-run claw tui-stats"
        return 0
    fi

    fires=$(echo "$tui_rows" | awk -F'\t' '$2 == "tui:fire"' | wc -l | tr -d ' ')
    esc_fallbacks=$(echo "$tui_rows" | awk -F'\t' '$2 == "tui:esc_to_default"' | wc -l | tr -d ' ')
    skip_picks=$(echo "$tui_rows" | awk -F'\t' '$2 == "tui:pick:skip"' | wc -l | tr -d ' ')

    local default_picks profile_picks tool_picks
    # Explicit picks (excluding ESC fallback, skip, separator).
    # Profile list = superset of shell/profiles/*.zsh (15 today). The TUI menu
    # currently exposes only ~8 of these explicitly, but widening the regex
    # means new profiles get counted correctly the moment the menu catches up
    # — no silent miscategorisation. NB: `vault` lives in the tool bucket
    # because the TUI's `vault` key routes to the Obsidian opener, not the
    # vault profile. If/when that changes, move vault → profile bucket.
    default_picks=$(echo "$tui_rows" | awk -F'\t' '$2 == "tui:pick:default"' | wc -l | tr -d ' ')
    profile_picks=$(echo "$tui_rows" | awk -F'\t' \
        '$2 ~ /^tui:pick:(security|cloud|devops|ai|research|cortex|claude|local|brainstorm|deck|demo|design|pmo)$/' \
        | wc -l | tr -d ' ')
    tool_picks=$(echo "$tui_rows" | awk -F'\t' \
        '$2 ~ /^tui:pick:(homelab|tunnel|ai_tools|mcp|agents|vault|onboard|integrity|tmux|yazi|update|doc|top)$/' \
        | wc -l | tr -d ' ')

    local since
    since=$(echo "$tui_rows" | head -1 | cut -f1)

    printf "\n  ${c_purple}${c_bold}claw tui-stats${c_reset}  ${c_dim}— %s TUI fires since %s${c_reset}\n" "$fires" "$since"
    printf "  ${c_dim}─────────────────────────────────────${c_reset}\n\n"

    printf "  ${c_cyan}${c_bold}Outcomes${c_reset}\n"
    printf "    ${c_green}%4d${c_reset}  ${c_dim}explicit non-default profile${c_reset}\n" "$profile_picks"
    printf "    ${c_green}%4d${c_reset}  ${c_dim}tool / system entry${c_reset}\n" "$tool_picks"
    printf "    ${c_orange}%4d${c_reset}  ${c_dim}explicit default pick${c_reset}\n" "$default_picks"
    printf "    ${c_orange}%4d${c_reset}  ${c_dim}ESC fallback to default${c_reset}\n" "$esc_fallbacks"
    printf "    ${c_red}%4d${c_reset}  ${c_dim}skip to bare shell${c_reset}\n" "$skip_picks"

    printf "\n  ${c_cyan}${c_bold}Per-key breakdown${c_reset}\n"
    echo "$tui_rows" | awk -F'\t' '$2 ~ /^tui:pick:/' | cut -f2 | sed 's/^tui:pick://' \
        | sort | uniq -c | sort -rn | \
        awk -v p=$'\e[38;2;188;140;255m' -v d=$'\e[38;2;139;148;158m' -v r=$'\e[0m' \
            '{ printf "    %s%4d%s  %s%s%s\n", p, $1, r, d, $2, r }'

    # ─────────────────────────────────────────────
    # VERDICT — your call, Henry. 5-10 lines.
    # The question: does the TUI deserve to exist as a forced login prompt?
    # Inputs available above as shell vars: fires, profile_picks, tool_picks,
    # default_picks, esc_fallbacks, skip_picks.
    #
    # Define what "earns its keep" means to YOU and print a recommendation.
    # Example threshold ideas (pick one or combine):
    #   - if (profile_picks + tool_picks) / fires < 0.20 → "KILL: 80%+ no-op"
    #   - if profile_picks per week < 2 → "KILL: rarely used as profile switcher"
    #   - if tool_picks > profile_picks × 3 → "REFRAME: it's a tool launcher, not a profile picker"
    # ─────────────────────────────────────────────
    tui_verdict "$fires" "$profile_picks" "$tool_picks" "$default_picks" "$esc_fallbacks" "$skip_picks"

    printf "\n  ${c_dim}log: %s${c_reset}\n\n" "$CLAW_USAGE_LOG"
}

# Default verdict — opinionated thresholds. Tune to taste.
#   KILL    if <20% of fires resulted in real work (profile switch or tool launch)
#   REFRAME if it's mostly a tool launcher (tool >= 3× profile picks)
#   REFRAME if useful work happens 20-50% of fires
#   KEEP    if ≥50% useful
# A 'skip to shell' rate >10% is flagged as a secondary signal.
tui_verdict() {
    local fires=$1 profile=$2 tool=$3 def=$4 esc=$5 skip=$6
    if (( fires < 30 )); then
        printf "\n  ${c_orange}${c_bold}Verdict${c_reset}  ${c_dim}— insufficient data (need ≥30 fires, have %s)${c_reset}\n" "$fires"
        return
    fi
    local useful=$((profile + tool)) noop=$((def + esc))
    local useful_pct=$(( useful * 100 / fires ))
    local skip_pct=$(( skip * 100 / fires ))
    printf "\n  ${c_orange}${c_bold}Verdict${c_reset}  ${c_dim}— %s%% of fires did real work, %s%% were no-ops${c_reset}\n" "$useful_pct" $(( noop * 100 / fires ))
    if (( useful_pct < 20 )); then
        printf "    ${c_red}● KILL${c_reset}     ${c_dim}TUI is mostly tax: %s/%s fires were no-ops. Move to opt-in (claw menu).${c_reset}\n" "$noop" "$fires"
    elif (( profile > 0 && tool >= profile * 3 )); then
        printf "    ${c_orange}● REFRAME${c_reset}  ${c_dim}used as a tool launcher (%s) far more than a profile picker (%s). Make tools the headline.${c_reset}\n" "$tool" "$profile"
    elif (( useful_pct < 50 )); then
        printf "    ${c_orange}● REFRAME${c_reset}  ${c_dim}used %s%% of fires. Default to last profile; surface TUI on demand.${c_reset}\n" "$useful_pct"
    else
        printf "    ${c_green}● KEEP${c_reset}     ${c_dim}earns its real estate at %s%% useful.${c_reset}\n" "$useful_pct"
    fi
    (( skip_pct > 10 )) && \
        printf "    ${c_dim}↳ %s%% of fires ended in 'skip to shell' — strong signal you want a faster path to bare prompt.${c_reset}\n" "$skip_pct"
}

cmd_validate() {
    # Full top-to-bottom install validation (symlinks → shell → CLI → GPU → AI →
    # desktop → peripherals → K3s → integrity) with update detection + fix hints.
    DOTFILES_DIR="$DOTFILES" exec bash "$DOTFILES/scripts/utils/validate-install.sh" "$@"
}

cmd_doctor() {
    # `claw doctor ai` → focused AI-workstation readiness check.
    if [[ "${1:-}" == "ai" ]]; then
        DOTFILES_DIR="$DOTFILES" exec bash "$DOTFILES/scripts/utils/ai-readiness.sh" "${@:2}"
    fi
    # `claw doctor --full` / `claw doctor all` → full install validation.
    if [[ "${1:-}" == "--full" || "${1:-}" == "all" ]]; then
        DOTFILES_DIR="$DOTFILES" exec bash "$DOTFILES/scripts/utils/validate-install.sh" "${@:2}"
    fi
    printf "\n  ${c_purple}${c_bold}claw doctor${c_reset}  ${c_dim}— %s${c_reset}\n" "$(date '+%Y-%m-%d %H:%M:%S')"
    printf "  ${c_dim}─────────────────────────────────────${c_reset}\n"
    [[ -n "$CLAW_ACTIVE_PROFILE" ]] && \
        ok "active profile: ${c_white}${c_bold}${CLAW_ACTIVE_PROFILE}${c_reset}" || \
        info "no profile loaded ${c_dim}(default)${c_reset}"
    info "dotfiles: ${c_dim}${DOTFILES}${c_reset}"
    info "agents:   ${c_dim}$(agent_list_sections | tr '\n' ' ')${c_reset}"

    printf "\n  ${c_purple}${c_bold}Core CLI${c_reset}\n"
    for tool in eza bat rg fd fzf zoxide atuin delta btop lazygit yazi starship gum glow tldr fastfetch; do
        if command -v "$tool" &>/dev/null; then
            ok "$tool"
        else
            err "$tool ${c_dim}— not installed${c_reset}"
        fi
    done

    if [[ -n "$CLAW_ACTIVE_PROFILE" ]]; then
        local check_fn="_${CLAW_ACTIVE_PROFILE}_tool_check"
        if typeset -f "$check_fn" &>/dev/null; then
            # Title-case the profile name in a bash-3.2 compatible way (the
            # ${var^} bashism is bash-4+, missing on stock macOS bash).
            local _title
            _title="$(printf '%s' "${CLAW_ACTIVE_PROFILE:0:1}" | tr '[:lower:]' '[:upper:]')${CLAW_ACTIVE_PROFILE:1}"
            printf "\n  ${c_purple}${c_bold}%s Profile${c_reset}\n" "$_title"
            "$check_fn"
        fi
    fi

    # GPU / Blackwell — only relevant on Linux with NVIDIA card present.
    # Cheap probes: command -v before nvidia-smi, never block on missing tools.
    if command -v nvidia-smi &>/dev/null; then
        printf "\n  ${c_purple}${c_bold}GPU / CUDA${c_reset}\n"
        local _gpu_name _gpu_drv _gpu_cap
        _gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
        _gpu_drv=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
        _gpu_cap=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1)
        if [[ -n "$_gpu_name" ]]; then
            ok "GPU: ${c_white}${_gpu_name}${c_reset} ${c_dim}(driver ${_gpu_drv}, sm_${_gpu_cap//./})${c_reset}"
            # Blackwell = compute capability 10.x or 12.x
            case "$_gpu_cap" in
                10.*|12.*) ok "Blackwell architecture detected ${c_dim}(FP4 + 5th-gen Tensor cores)${c_reset}" ;;
                9.*)       info "Hopper architecture ${c_dim}(H100-class)${c_reset}" ;;
                8.9)       info "Ada Lovelace ${c_dim}(RTX 40-series / L40)${c_reset}" ;;
                *)         info "compute capability $_gpu_cap" ;;
            esac
        else
            err "nvidia-smi installed but no GPU enumerated ${c_dim}— driver or hardware issue${c_reset}"
        fi
        if command -v nvcc &>/dev/null; then
            ok "nvcc ${c_dim}$(nvcc --version | grep release | sed 's/.*release \([0-9.]*\).*/\1/')${c_reset}"
        else
            err "nvcc ${c_dim}— CUDA toolkit missing (run: claw install ai-workstation)${c_reset}"
        fi
        if command -v nvidia-ctk &>/dev/null; then
            ok "nvidia-container-toolkit ${c_dim}$(nvidia-ctk --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)${c_reset}"
        else
            err "nvidia-container-toolkit ${c_dim}— required for docker/K3s GPU pass-through${c_reset}"
        fi
        # K3s GPU resource check — only if both kubectl and a kubeconfig exist
        if command -v kubectl &>/dev/null && [[ -r "${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}" ]]; then
            local _k_gpu
            _k_gpu=$(KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}" \
                kubectl get nodes -o jsonpath='{.items[*].status.capacity.nvidia\.com/gpu}' 2>/dev/null | tr -d ' ')
            if [[ -n "$_k_gpu" ]]; then
                ok "K3s GPU resources ${c_dim}(nvidia.com/gpu = ${_k_gpu})${c_reset}"
            else
                err "K3s GPU device plugin not advertising ${c_dim}— apply: $DOTFILES/config/k3s/gpu/${c_reset}"
            fi
        fi
    fi

    # AI agents (Hermes + OpenRouter) — independent checks, none fatal.
    printf "\n  ${c_purple}${c_bold}AI Agents${c_reset}\n"
    if command -v ollama &>/dev/null; then
        ok "ollama ${c_dim}($(ollama --version 2>/dev/null | head -1))${c_reset}"
        if curl -fsS --max-time 2 http://localhost:11434/api/tags &>/dev/null; then
            ok "ollama daemon ${c_dim}reachable at :11434${c_reset}"
            local _hm="${CLAW_HERMES_MODEL:-hermes3:8b}"
            if ollama list 2>/dev/null | awk 'NR>1 {print $1}' | grep -Fxq "$_hm"; then
                ok "hermes model ${c_dim}$_hm${c_reset}"
            else
                err "hermes model ${c_dim}$_hm — not pulled (run: claw install ai)${c_reset}"
            fi
        else
            err "ollama daemon ${c_dim}— not reachable (start: claw hermes --serve)${c_reset}"
        fi
    else
        err "ollama ${c_dim}— not installed (run: claw install ai)${c_reset}"
    fi
    if command -v aichat &>/dev/null; then
        ok "aichat ${c_dim}($(aichat --version 2>/dev/null))${c_reset}"
    else
        err "aichat ${c_dim}— not installed (run: claw install ai)${c_reset}"
    fi
    if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
        if [[ "$OPENROUTER_API_KEY" == op://* ]]; then
            err "OPENROUTER_API_KEY ${c_dim}— op:// not resolved (install 1Password CLI: brew install 1password-cli)${c_reset}"
        else
            ok "OPENROUTER_API_KEY ${c_dim}set${c_reset}"
        fi
    else
        err "OPENROUTER_API_KEY ${c_dim}— not set (add to ~/.dotfiles/.env)${c_reset}"
    fi

    # Self-hosted AI web stacks (open-webui / dify / ragflow / langfuse).
    # Informational — these are opt-in services, never a validate failure.
    printf "\n  ${c_purple}${c_bold}AI Services${c_reset} ${c_dim}(claw ai-services)${c_reset}\n"
    local _svc _port
    for _svc in "open-webui:3000" "dify:8080" "ragflow:8081" "langfuse:3000"; do
        _port="${_svc##*:}"; _svc="${_svc%%:*}"
        if curl -fsS --max-time 1 "http://localhost:${_port}" &>/dev/null; then
            ok "${_svc} ${c_dim}→ http://localhost:${_port}${c_reset}"
        else
            printf "  ${c_dim}·${c_reset} ${_svc} ${c_dim}stopped (start: claw ai-services up ${_svc})${c_reset}\n"
        fi
    done

    echo ""
}

# ONE front door for the three updaters (each keeps its own job):
#   claw update              system packages (brew/apt/npm/pip…)  → system-update.sh
#   claw update --tools      interactive curated CLI refresh      → tool-updater.sh
#   claw update --schedule   weekly auto-update timer             → selfupdate.sh
# `claw tools` / `claw selfupdate` still work as muscle-memory aliases.
cmd_update() {
    case "${1:-}" in
        --tools|tools)       shift; bash "$DOTFILES/scripts/utils/tool-updater.sh" --interactive "$@" ;;
        --schedule|schedule) shift; bash "$DOTFILES/scripts/utils/selfupdate.sh" "${1:-install}" ;;
        *)                   bash "$DOTFILES/scripts/utils/system-update.sh" "$@" ;;
    esac
}

