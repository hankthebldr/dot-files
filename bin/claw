#!/usr/bin/env bash
# claw — single entry point for Open Claw dotfiles
# Routes to skills, MCP, homelab, tunnels, agents, profiles, updates
#
# Usage: claw [subcommand] [args...]
# Run `claw help` for the full list.

set -e

DOTFILES="${DOTFILES_DIR:-$HOME/.dotfiles}"
CLAW_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claw"
AGENTS_TOML="$CLAW_CONFIG_DIR/agents.toml"
CLAW_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claw"
CLAW_USAGE_LOG="$CLAW_CACHE_DIR/usage.tsv"

# ============================================
# THEME — from the active Open Claw palette (theme.sh single source of truth).
# Sourcing exports CLAW_RGB_*; fallbacks are refined-dark so claw renders
# correctly even if theme.sh is missing (e.g. mid-bootstrap).
# ============================================
# shellcheck source=/dev/null
[ -r "$DOTFILES/scripts/utils/theme.sh" ] && . "$DOTFILES/scripts/utils/theme.sh" 2>/dev/null || true
c_reset=$'\e[0m'
c_cyan=$'\e[38;2;'"${CLAW_RGB_BLUE:-88;166;255}"$'m'
c_green=$'\e[38;2;'"${CLAW_RGB_GREEN:-63;185;80}"$'m'
c_purple=$'\e[38;2;'"${CLAW_RGB_PURPLE:-188;140;255}"$'m'
c_orange=$'\e[38;2;'"${CLAW_RGB_AMBER:-227;179;65}"$'m'
c_red=$'\e[38;2;'"${CLAW_RGB_RED:-255;123;114}"$'m'
c_dim=$'\e[38;2;'"${CLAW_RGB_MUTED:-139;148;158}"$'m'
c_white=$'\e[38;2;'"${CLAW_RGB_FG:-201;209;217}"$'m'
c_bold=$'\e[1m'

# NO_COLOR (https://no-color.org) — registry.sh help already honours it, so
# `claw help` was half-plain and half-SGR. One switch for the whole surface.
if [ -n "${NO_COLOR:-}" ]; then
    c_reset=""; c_cyan=""; c_green=""; c_purple=""; c_orange=""
    c_red=""; c_dim=""; c_white=""; c_bold=""
fi

err()  { printf "  ${c_red}✗${c_reset} %s\n" "$*" >&2; }
info() { printf "  ${c_cyan}●${c_reset} %s\n" "$*"; }
ok()   { printf "  ${c_green}✓${c_reset} %s\n" "$*"; }

# ============================================
# USAGE LOGGER
# ============================================
# Append-only TSV, 5 columns (audit F-16):
#   ISO timestamp \t event \t arg-count \t profile \t term=…;actor=…
# The 5th column is what the old instrument was missing: without an actor tag
# `claw tui-stats` could not tell Henry's own logins from the agent loops that
# are 2/3 of the CLI volume, so every rate it printed was wrong. The 4-column
# readers (cmd_stats, situation) still parse — the column is additive.
# `claw load <p>` logs as `load:<p>` because the TARGET, not the profile that
# was active at dispatch time, is the datum autoload accuracy needs.
# Disable with CLAW_NO_LOG=1. Errors are swallowed — must never block dispatch.
log_usage() {
    [[ "$CLAW_NO_LOG" = "1" ]] && return 0
    {
        mkdir -p "$CLAW_CACHE_DIR" 2>/dev/null
        local _ev _actor
        _ev="${1:-menu}"
        _actor=human
        if [[ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ]]; then _actor=agent; fi
        if [[ "$_ev" == "load" && -n "${3:-}" ]]; then _ev="load:$3"; fi
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            "$_ev" \
            "$(( $# > 0 ? $# - 1 : 0 ))" \
            "${CLAW_ACTIVE_PROFILE:-none}" \
            "term=${TERM_PROGRAM:-$TERM};actor=$_actor" \
            >> "$CLAW_USAGE_LOG"
    } 2>/dev/null || true
}

# ============================================
# AGENTS REGISTRY
# ============================================
# Canonical default agents, emitted one [section] at a time so ensure_agents_toml
# can append only the MISSING ones. A registry created before a new default
# shipped (e.g. opencode/openwork) self-heals to the current set without
# clobbering hand-added entries or user edits.
DEFAULT_AGENT_NAMES=(claude gemini hermes openrouter aichat opencode openwork)

_default_agent_block() {
    case "$1" in
        claude) cat <<'EOF'

[claude]
command = "claude"
profile = "claude"
description = "Anthropic Claude Code"
EOF
        ;;
        gemini) cat <<'EOF'

[gemini]
command = "gemini"
profile = "ai"
description = "Google Gemini CLI (@google/gemini-cli)"
EOF
        ;;
        hermes) cat <<'EOF'

[hermes]
command = "hermes"
profile = "ai"
kind = "local"
description = "Hermes 3 local agent (Ollama)"
EOF
        ;;
        openrouter) cat <<'EOF'

[openrouter]
command = "openrouter"
profile = "ai"
kind = "chat"
description = "OpenRouter via aichat"
EOF
        ;;
        aichat) cat <<'EOF'

[aichat]
command = "aichat"
profile = "ai"
kind = "chat"
description = "Multi-provider chat/pipe"
EOF
        ;;
        opencode) cat <<'EOF'

[opencode]
command = "opencode"
profile = "ai"
kind = "agent"
description = "Terminal AI coding agent (opencode.ai)"
EOF
        ;;
        openwork) cat <<'EOF'

[openwork]
command = "openwork"
profile = "ai"
kind = "agent"
args = "start"
description = "Headless OpenWork orchestrator — Cowork alt on opencode (claw openwork → openwork start)"
EOF
        ;;
    esac
}

ensure_agents_toml() {
    mkdir -p "$CLAW_CONFIG_DIR"
    local created=0
    if [[ ! -f "$AGENTS_TOML" ]]; then
        cat > "$AGENTS_TOML" <<'EOF'
# Open Claw agent registry
# Add an entry per coding/AI agent you use. `claw <name>` launches it.
# Keys: command (required), profile, description, kind, args
#   args = default arguments used ONLY when you pass none, e.g. openwork's
#          args = "start" makes bare `claw openwork` launch the orchestrator.
EOF
        created=1
    fi
    local name added=()
    for name in "${DEFAULT_AGENT_NAMES[@]}"; do
        grep -q "^\[$name\]$" "$AGENTS_TOML" 2>/dev/null && continue
        _default_agent_block "$name" >> "$AGENTS_TOML"
        added+=("$name")
    done
    if [[ "$created" == 1 ]]; then
        info "Created $AGENTS_TOML (${#DEFAULT_AGENT_NAMES[@]} default agents)"
    elif (( ${#added[@]} )); then
        info "agents.toml: registered new default agents → ${added[*]}"
    fi
}

# Parse a single key from a [section] of agents.toml.
# Usage: agent_get <section> <key>
agent_get() {
    local section="$1" key="$2"
    awk -v s="[$section]" -v k="$key" '
        $0 == s        { in_section = 1; next }
        /^\[/          { in_section = 0 }
        in_section && $1 == k && $2 == "=" {
            $1 = $2 = ""
            sub(/^[ \t]+/, "")
            gsub(/^"|"$/, "")
            print
            exit
        }
    ' "$AGENTS_TOML" 2>/dev/null
}

# List all agent section names.
agent_list_sections() {
    awk '/^\[[a-zA-Z0-9_-]+\]$/ { gsub(/^\[|\]$/, ""); print }' "$AGENTS_TOML" 2>/dev/null
}

# ============================================
# SUBCOMMANDS
# ============================================

# Portable file age in seconds (BSD stat -f / GNU stat -c). Empty when the
# file is absent — callers render that as "absent", never as 0s.
_file_age() {
    local m
    m="$(stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null)" || return 0
    [ -n "$m" ] || return 0
    printf '%s' "$(( $(date +%s) - m ))"
}

_fmt_age() {
    local s="${1:-0}"
    if   [ "$s" -lt 60 ];    then printf '%ss' "$s"
    elif [ "$s" -lt 3600 ];  then printf '%sm' "$(( s / 60 ))"
    elif [ "$s" -lt 86400 ]; then printf '%sh' "$(( s / 3600 ))"
    else                          printf '%sd' "$(( s / 86400 ))"
    fi
}

# ONE registry front door for every generated surface in this file (help,
# tui-stats classification, the `registry` arm). Returns 1 when the emitter is
# absent so callers can fall back instead of printing nothing.
_registry() {
    [ -r "$DOTFILES/scripts/utils/registry.sh" ] || return 1
    DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/registry.sh" "$@"
}

# Audit F-15: help (45 entries), completion (39) and the menu (~12) were three
# hand-maintained copies of a 48-arm dispatcher, and they disagreed — `harness`,
# Henry's most-used verb, was in none of them. The Profiles section and the
# per-verb lines now come from `registry.sh help`, which reads the same
# meta.zsh + actions.tsv the palette and completion do. Only the frame and the
# two things the registry does not own (agents, the bare-profile shorthand)
# are written here.
_help_fallback() {
    printf "  ${c_dim}registry unavailable (%s) — core doors:${c_reset}\n" \
        "$DOTFILES/scripts/utils/registry.sh"
    printf "    ${c_white}claw doctor${c_reset}    ${c_dim}system + attention detail${c_reset}\n"
    printf "    ${c_white}claw update${c_reset}    ${c_dim}repo sync then packages${c_reset}\n"
    printf "    ${c_white}claw load <p>${c_reset}  ${c_dim}source a profile in this shell${c_reset}\n"
}

cmd_help() {
    printf "\n  ${c_purple}${c_bold}claw${c_reset} — ${c_dim}Open Claw dispatcher${c_reset}\n"
    _registry help || _help_fallback
    printf "\n  ${c_purple}${c_bold} shorthand${c_reset}\n"
    printf "   ${c_white}claw <profile>${c_reset}  ${c_dim}bare profile name = claw load <profile>${c_reset}\n"
    printf "   ${c_white}claw <agent>${c_reset}    ${c_dim}launch a registered agent (claude, hermes, …)${c_reset}\n"
    printf "   ${c_white}claw${c_reset}            ${c_dim}open the palette in zsh (also ^G)${c_reset}\n"
    printf "\n  ${c_dim}Config: %s${c_reset}\n\n" "$AGENTS_TOML"
}

# Audit F-18: this spawned `zsh -i -c` which INHERITED CLAW_ACTIVE_PROFILE, so
# welcome-tui's own guard returned immediately and `claw menu` was a silent
# no-op from inside any loaded profile — exactly when you reach for it. The
# palette is an in-shell surface (it has to be: picking a profile must mutate
# THIS shell), so the bash dispatcher's only honest job is to say where it is.
cmd_menu() {
    info "the palette runs in-shell: type  ${c_white}claw${c_reset}  (or press ${c_white}^G${c_reset}) in zsh"
    return 0
}

cmd_stats() {
    if [[ ! -s "$CLAW_USAGE_LOG" ]]; then
        info "no usage logged yet ${c_dim}($CLAW_USAGE_LOG)${c_reset}"
        info "use claw normally for a few days, then re-run claw stats"
        return 0
    fi
    local total since
    total=$(wc -l < "$CLAW_USAGE_LOG" | tr -d ' ')
    since=$(head -1 "$CLAW_USAGE_LOG" | cut -f1)
    printf "\n  ${c_purple}${c_bold}claw stats${c_reset}  ${c_dim}— %s invocations since %s${c_reset}\n" "$total" "$since"
    printf "  ${c_dim}─────────────────────────────────────${c_reset}\n\n"
    printf "  ${c_cyan}${c_bold}By subcommand${c_reset}\n"
    cut -f2 "$CLAW_USAGE_LOG" | sort | uniq -c | sort -rn | \
        awk -v g=$'\e[38;2;63;185;80m' -v d=$'\e[38;2;139;148;158m' -v r=$'\e[0m' \
            '{ printf "    %s%4d%s  %s%s%s\n", g, $1, r, d, $2, r }'
    printf "\n  ${c_cyan}${c_bold}By profile${c_reset}\n"
    cut -f4 "$CLAW_USAGE_LOG" | sort | uniq -c | sort -rn | \
        awk -v g=$'\e[38;2;188;140;255m' -v d=$'\e[38;2;139;148;158m' -v r=$'\e[0m' \
            '{ printf "    %s%4d%s  %s%s%s\n", g, $1, r, d, $2, r }'
    printf "\n  ${c_dim}log: %s${c_reset}\n\n" "$CLAW_USAGE_LOG"
}

# Audit F-16 — this is the instrument that told Henry the wrong thing.
#
# The old version reported "13% no-ops" against a true 85% dark rate because
# (a) it divided by `tui:fire` rows only, which were written AFTER a pick, so
# every abandoned login was invisible; (b) it bucketed picks with two hardcoded
# regexes that filed `vault` and `homelab` under "tools" although both are
# profiles; and (c) it mixed Henry's logins with the agent loop that is 2/3 of
# the row volume. The rewrite windows the log, splits by actor, classifies
# picks from the registry, and computes the two rates the old one structurally
# could not: abandonment and autoload accuracy.
#
#   claw tui-stats [--days N] [--actor human|agent|all]
#
# Legacy 4-column `tui:fire` / `tui:pick:<id>` / `tui:esc_to_default` rows are
# still counted — they are most of the existing log — and land in the `unknown`
# actor bucket, which is reported explicitly rather than silently folded in.
cmd_tui_stats() {
    local days=30 actor=human
    while [ $# -gt 0 ]; do
        case "$1" in
            --days)    days="${2:-}"; shift 2 ;;
            --days=*)  days="${1#*=}"; shift ;;
            --actor)   actor="${2:-}"; shift 2 ;;
            --actor=*) actor="${1#*=}"; shift ;;
            -h|--help)
                printf "  ${c_white}claw tui-stats${c_reset} ${c_dim}[--days N] [--actor human|agent|all]${c_reset}\n"
                return 0 ;;
            *) err "unknown flag: $1 ${c_dim}(claw tui-stats --help)${c_reset}"; return 2 ;;
        esac
    done
    case "$actor" in
        human|agent|all) ;;
        *) err "--actor must be human, agent or all (got '${actor}')"; return 2 ;;
    esac
    case "$days" in
        ''|*[!0-9]*) err "--days must be a positive integer (got '${days}')"; return 2 ;;
    esac
    [ "$days" -gt 0 ] || { err "--days must be a positive integer (got '${days}')"; return 2; }

    if [[ ! -s "$CLAW_USAGE_LOG" ]]; then
        info "no usage logged yet ${c_dim}($CLAW_USAGE_LOG)${c_reset}"
        info "open a few fresh shells, then re-run claw tui-stats"
        return 0
    fi

    # The registry is the classifier: kind (profile|action) and group per id,
    # aliases included. Absent registry → every pick reads `unclassified`,
    # which is honest, rather than a regex that guesses.
    local reg; reg="$(mktemp "${TMPDIR:-/tmp}/claw-reg.XXXXXX")"
    _registry rows > "$reg" 2>/dev/null || : > "$reg"

    awk -F'\t' \
        -v reg="$reg" \
        -v now="${CLAW_NOW:-$(date +%s)}" \
        -v days="$days" -v actor="$actor" -v logf="$CLAW_USAGE_LOG" \
        -v c0="$c_reset" -v cb="$c_bold" -v cp="$c_purple" -v cg="$c_green" \
        -v co="$c_orange" -v cr="$c_red" -v cd="$c_dim" -v cw="$c_white" \
        -v ck="$c_cyan" '
    # ---- ISO-8601 UTC -> epoch. No mktime(): BSD awk has none. Hinnant
    #      days-from-civil, integer arithmetic only, portable to mawk.
    function iso2epoch(s,   y,m,d,hh,mm,ss,era,yoe,doy,doe,dfc) {
        y = substr(s,1,4)+0; m = substr(s,6,2)+0; d = substr(s,9,2)+0
        hh = substr(s,12,2)+0; mm = substr(s,15,2)+0; ss = substr(s,18,2)+0
        if (y < 1970 || m < 1 || m > 12) return -1
        if (m <= 2) y = y - 1
        if (y >= 0) era = int(y/400); else era = int((y-399)/400)
        yoe = y - era*400
        if (m > 2) doy = int((153*(m-3)+2)/5) + d - 1
        else       doy = int((153*(m+9)+2)/5) + d - 1
        doe = yoe*365 + int(yoe/4) - int(yoe/100) + doy
        dfc = era*146097 + doe - 719468
        return dfc*86400 + hh*3600 + mm*60 + ss
    }
    # ---- one k=v;k=v payload value
    function payval(p, k,   n,i,a,at) {
        if (p == "") return ""
        n = split(p, a, ";")
        for (i = 1; i <= n; i++) {
            at = index(a[i], "=")
            if (at > 0 && substr(a[i], 1, at-1) == k) return substr(a[i], at+1)
        }
        return ""
    }
    function pct(a, b) { if (b <= 0) return 0; return int(a*100/b + 0.5) }
    # ---- top-N without asort(): repeated max, ties broken by key so two awks
    #      on the same input print the same table.
    function topn(arr, n, withkind,   i,k,best,bk,used,kd) {
        for (i = 0; i < n; i++) {
            best = -1; bk = ""
            for (k in arr) {
                if (k in used) continue
                if (arr[k] > best || (arr[k] == best && k < bk)) { best = arr[k]; bk = k }
            }
            if (bk == "") return
            used[bk] = 1
            if (withkind) {
                kd = "unclassified"
                if (bk in kind) kd = kind[bk]
                printf "    %s%4d%s  %s%-16s%s %s%s%s\n", cg, arr[bk], c0, cw, bk, c0, cd, kd, c0
            } else {
                printf "    %s%4d%s  %s%s%s\n", cg, arr[bk], c0, cd, bk, c0
            }
        }
    }
    BEGIN { cutoff = now - days*86400 }

    # ---- pass 1: the registry (kind + group per id and per alias)
    FILENAME == reg {
        kind[$2] = $1
        if ($3 != "-" && $3 != "") {
            n = split($3, al, "|")
            for (i = 1; i <= n; i++) if (!(al[i] in kind)) kind[al[i]] = $1
        }
        next
    }

    # ---- pass 2: the usage log
    {
        total++
        e = iso2epoch($1)
        if (e < 0 || e < cutoff) next
        inwin++
        pay = ""
        if (NF >= 5) pay = $5
        act = payval(pay, "actor")
        if (act == "") act = "unknown"
        b = "unknown"
        if (act == "agent") b = "agent"
        else if (act == "human" || act == "ide" || act == "ssh") b = "human"
        if (b == "unknown") unattr++
        show = 0
        if (actor == "all" || actor == b) show = 1
        human = (b == "human")

        ev = $2
        if (ev ~ /^tui:login:/) {
            x = substr(ev, 11); ci = index(x, ":")
            if (ci > 0) { mode = substr(x, 1, ci-1); lp = substr(x, ci+1) }
            else        { mode = x; lp = $4 }
            if (show) { logins[mode " -> " lp]++; nlogins++; d_nl++; dl_t[d_nl] = e; dl_p[d_nl] = lp }
            if (human) h_logins++
        }
        else if (ev == "tui:fire") {
            # pre-instrumentation login row: no mode, no actor
            if (show) { logins["legacy -> (untagged)"]++; nlogins++ }
        }
        else if (ev ~ /^tui:abort:/) {
            ph = substr(ev, 11)
            if (show) { aborts[ph]++; naborts++ }
            if (human) h_aborts++
        }
        else if (ev == "tui:palette:open" || ev == "tui:open") {
            if (show) opens++
            if (human) h_opens++
        }
        else if (ev ~ /^tui:palette:pick/ || ev ~ /^tui:pick:/) {
            id = ""
            if (ev ~ /^tui:palette:pick:/) id = substr(ev, 18)
            else if (ev ~ /^tui:pick:/)    id = substr(ev, 10)
            if (id == "") id = payval(pay, "id")
            if (id == "") id = "(unknown)"
            if (show) { picks[id]++; npicks++ }
            if (human) h_picks++
        }
        else if (ev == "tui:palette:esc" || ev == "tui:esc_to_default") {
            q = payval(pay, "q")
            if (show) { esc++; if (q != "") { noq[q]++; nnoq++ } }
            if (human) h_esc++
        }
        else if (ev ~ /^load:/) {
            if (show) { d_nd++; dd_t[d_nd] = e; dd_p[d_nd] = substr(ev, 6); verbs["load"]++; nverbs++ }
        }
        else if (ev !~ /^tui:/) {
            if (show) { verbs[ev]++; nverbs++ }
        }
    }

    END {
        printf "\n  %s%sclaw tui-stats%s  %s— last %d days · actor %s · %d of %d rows in window%s\n",
               cp, cb, c0, cd, days, actor, inwin, total, c0
        printf "  %s---------------------------------------------------------%s\n\n", cd, c0

        printf "  %s%sLogins by mode -> profile%s\n", ck, cb, c0
        if (nlogins == 0) printf "    %s(none in window)%s\n", cd, c0
        else topn(logins, 12, 0)

        # Abandonment: the rate the old instrument could not see at all,
        # because it only counted fires that had already produced an outcome.
        printf "\n  %s%sAbort rate%s  %s(tui:abort:* over %s logins)%s\n", ck, cb, c0, cd, actor, c0
        if (nlogins == 0) printf "    %sno logins in window%s\n", cd, c0
        else {
            printf "    %s%d/%d%s  %s%d%%%s", co, naborts, nlogins, c0, co, pct(naborts, nlogins), c0
            sep = "   "
            for (k in aborts) { printf "%s%s%s %d%s", sep, cd, k, aborts[k], c0; sep = " · " }
            printf "\n"
            if (naborts == 0) printf "    %sinit = shell exited before its first prompt · render = Ctrl-C during the strip%s\n", cd, c0
        }

        printf "\n  %s%sPalette%s\n", ck, cb, c0
        printf "    %sopens%s %d   %spicks%s %d   %sesc%s %d", cd, c0, opens+0, cd, c0, npicks+0, cd, c0, esc+0
        if (nlogins > 0) printf "   %s· %d opens per 100 %s logins%s", cd, pct(opens, nlogins), actor, c0
        if (opens > 0)    printf "   %s· %d%% pick rate%s", cd, pct(npicks, opens), c0
        printf "\n"

        # Autoload accuracy: a human login whose profile the user overrode with
        # `claw load <other>` inside 300 s is the autoloader guessing wrong.
        printf "\n  %s%sAutoload accuracy%s  %s(login not corrected by claw load <other> within 300s)%s\n", ck, cb, c0, cd, c0
        if (d_nl == 0) printf "    %sno %s logins in window%s\n", cd, actor, c0
        else {
            corrected = 0
            for (i = 1; i <= d_nl; i++) {
                for (j = 1; j <= d_nd; j++) {
                    if (dd_t[j] >= dl_t[i] && dd_t[j] - dl_t[i] <= 300 && dd_p[j] != dl_p[i]) {
                        corrected++; break
                    }
                }
            }
            printf "    %s%d/%d%s  %s%d%%%s   %s%d corrected%s\n",
                   cg, d_nl - corrected, d_nl, c0, cg, pct(d_nl - corrected, d_nl), c0,
                   cd, corrected, c0
        }

        printf "\n  %s%sTop picks%s  %s(kind from the registry, not a regex)%s\n", ck, cb, c0, cd, c0
        if (npicks == 0) printf "    %s(none in window)%s\n", cd, c0
        else topn(picks, 10, 1)

        printf "\n  %s%sNo-pick queries%s  %s(typed, then ESC)%s\n", ck, cb, c0, cd, c0
        if (nnoq == 0) printf "    %s(none in window)%s\n", cd, c0
        else topn(noq, 8, 0)

        printf "\n  %s%sTop verbs%s  %s(CLI dispatch rows)%s\n", ck, cb, c0, cd, c0
        if (nverbs == 0) printf "    %s(none in window)%s\n", cd, c0
        else topn(verbs, 10, 0)

        if (unattr > 0)
            printf "\n  %sunattributed: %d rows in window predate the actor column%s\n", cd, unattr, c0

        # ---- Verdict. HUMAN rows only, always, whatever --actor displayed.
        printf "\n  %s%sVerdict%s  %s(human rows only)%s\n", co, cb, c0, cd, c0
        if (h_logins < 30)
            printf "    %s● insufficient data%s  %s%d human logins in window, need 30%s\n", cd, c0, cd, h_logins, c0
        else if (h_opens == 0)
            printf "    %s● DARK%s     %sthe palette was never opened in %d human logins — it is opt-in and earns nothing yet%s\n", cr, c0, cd, h_logins, c0
        else if (pct(h_opens, h_logins) < 20)
            printf "    %s● OPT-IN%s   %sopened on %d%% of logins — correct for an on-demand surface, wrong for a forced one%s\n", co, c0, cd, pct(h_opens, h_logins), c0
        else if (h_opens > 0 && pct(h_picks, h_opens) < 40)
            printf "    %s● REFRAME%s  %sopened %d times, picked %d — the list is not answering the query%s\n", co, c0, cd, h_opens, h_picks, c0
        else
            printf "    %s● KEEP%s     %s%d%% of opens end in a pick%s\n", cg, c0, cd, pct(h_picks, h_opens), c0
        if (h_logins > 0 && pct(h_aborts, h_logins) > 10)
            printf "    %s-> %d%% of human logins aborted before a prompt — look at the render, not the palette%s\n", cd, pct(h_aborts, h_logins), c0

        printf "\n  %slog: %s%s\n\n", cd, logf, c0
    }
    ' "$reg" "$CLAW_USAGE_LOG"

    rm -f "$reg"
}

# ============================================
# REGISTRY-BACKED ARMS  (audit F-15 / F-18)
# ============================================
# The four arms the registry already had rows for. Adding them here is what
# lets scripts/utils/registry.sh drop PENDING_ARMS and go back to being a real
# guard against a typo'd `run` snippet.

# `claw registry <cmd>` — the emitter, reachable without knowing its path.
cmd_registry() {
    [ -r "$DOTFILES/scripts/utils/registry.sh" ] || { err "registry.sh not found under $DOTFILES"; return 1; }
    DOTFILES_DIR="$DOTFILES" exec bash "$DOTFILES/scripts/utils/registry.sh" "$@"
}

# `claw pin [<profile>|--clear]` — the per-machine login profile claw_login
# already reads. One line, one file, no schema.
cmd_pin() {
    local pinfile="$CLAW_CONFIG_DIR/login-profile"
    case "${1:-}" in
        "")
            if [ -r "$pinfile" ]; then
                info "login profile: ${c_white}$(head -1 "$pinfile" | tr -d '[:space:]')${c_reset} ${c_dim}($pinfile)${c_reset}"
            else
                info "login profile: ${c_white}default${c_reset} ${c_dim}(no pin set — claw pin <profile>)${c_reset}"
            fi
            ;;
        --clear|clear)
            rm -f "$pinfile"
            ok "login pin cleared ${c_dim}(logins fall back to default)${c_reset}"
            ;;
        -h|--help)
            printf "  ${c_white}claw pin${c_reset} ${c_dim}[<profile>|--clear]${c_reset}\n"
            ;;
        *)
            if [ ! -f "$DOTFILES/shell/profiles/$1.zsh" ]; then
                err "no such profile: $1 ${c_dim}(claw registry ids profiles)${c_reset}"
                return 1
            fi
            mkdir -p "$CLAW_CONFIG_DIR"
            printf '%s\n' "$1" > "$pinfile"
            ok "login profile pinned to ${c_white}$1${c_reset}"
            ;;
    esac
}

# `claw ack <id> [--hours N]` — silence one attention item for a while.
# situation.sh's evaluate already reads acks.tsv as `<id>\t<until_epoch>`;
# this is the writer, and it re-evaluates so the strip and ⚑ update at once.
cmd_ack() {
    local id="" hours=8
    while [ $# -gt 0 ]; do
        case "$1" in
            --hours)   hours="${2:-}"; shift 2 ;;
            --hours=*) hours="${1#*=}"; shift ;;
            -h|--help) printf "  ${c_white}claw ack${c_reset} ${c_dim}<id> [--hours N]   (ids: claw situation show)${c_reset}\n"; return 0 ;;
            *) [ -z "$id" ] && id="$1"; shift ;;
        esac
    done
    if [ -z "$id" ]; then
        err "usage: claw ack <id> [--hours N]"
        return 2
    fi
    case "$hours" in ''|*[!0-9]*) err "--hours must be a positive integer (got '${hours}')"; return 2 ;; esac

    local state="${XDG_STATE_HOME:-$HOME/.local/state}/claw"
    mkdir -p "$state"
    printf '%s\t%s\n' "$id" "$(( $(date +%s) + hours * 3600 ))" >> "$state/acks.tsv"
    ok "acked ${c_white}${id}${c_reset} ${c_dim}for ${hours}h${c_reset}"
    if [ -r "$DOTFILES/scripts/utils/situation.sh" ]; then
        DOTFILES_DIR="$DOTFILES" bash "$DOTFILES/scripts/utils/situation.sh" evaluate >/dev/null 2>&1 || true
    fi
}

# `claw dash` — the login card on demand (same render path as the hook).
cmd_dash() {
    [ -r "$DOTFILES/scripts/utils/claw-dashboard.py" ] || { err "claw-dashboard.py not found under $DOTFILES"; return 1; }
    DOTFILES_DIR="$DOTFILES" exec python3 "$DOTFILES/scripts/utils/claw-dashboard.py" --login "$@"
}

