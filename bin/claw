    tun|tunnel)     shift; cmd_tun "$@" ;;
    mcp)            shift; cmd_mcp "$@" ;;
    homelab)        shift; cmd_homelab "$@" ;;
    toolkit)        shift; cmd_toolkit "$@" ;;
    ai-services|aisvc|services) shift; cmd_ai_services "$@" ;;
    docker|containers|dps) shift; cmd_docker "$@" ;;
    skills)         shift; cmd_skills "$@" ;;
    harness)        shift; cmd_harness "$@" ;;
    obsidian|vault) shift; cmd_obsidian "$@" ;;
    onboard|onboarding|character) shift; cmd_onboard "$@" ;;
    integrity|verify|check) shift; cmd_integrity "$@" ;;
    load)           shift; cmd_load "$@" ;;
    off)            cmd_off ;;
    restore-shell|relink) cmd_restore_shell ;;
    lock-shell)     cmd_lock_shell ;;
    unlock-shell)   cmd_unlock_shell ;;
    docs-sync|docs)  bash "$DOTFILES/scripts/utils/docs-to-vault.sh" ;;
    install)        shift; cmd_install "$@" ;;
    provision)      shift; bash "$DOTFILES/scripts/install/provision.sh" "$@" ;;
    pkg|packages)   shift; bash "$DOTFILES/scripts/utils/pkg-manifest.sh" "$@" ;;
    secret|secrets)  shift; bash "$DOTFILES/scripts/utils/secret.sh" "$@" ;;
    ai)             shift; bash "$DOTFILES/scripts/utils/ai.sh" "$@" ;;
    handoff)        shift; bash "$DOTFILES/scripts/utils/handoff.sh" "$@" ;;
    mcp-sync)       shift; python3 "$DOTFILES/scripts/utils/mcp-sync.py" "$@" ;;
    selfupdate)     shift; bash "$DOTFILES/scripts/utils/selfupdate.sh" "$@" ;;
    capture-tasks)  shift; bash "$DOTFILES/scripts/utils/capture-tasks.sh" "$@" ;;
    cheatsheet|cheat) bash "$DOTFILES/scripts/utils/cheatsheet.sh" ;;
    theme|themes|colors) shift; cmd_theme "$@" ;;
    output)         shift; bash "$DOTFILES/scripts/utils/claw-output.sh" "$@" ;;
    storage)        shift; bash "$DOTFILES/scripts/utils/storage-doctor.sh" "$@" ;;
    gpu|gpu-node)   shift; cmd_gpu "$@" ;;
    gateway|openshell) shift; cmd_gateway "$@" ;;
    uninstall|remove) shift; cmd_uninstall "$@" ;;
    claude-sync|csync) shift; cmd_claude "$@" ;;
