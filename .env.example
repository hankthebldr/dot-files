# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit secrets.
#
# Optional: any value starting with op:// is resolved via 1Password CLI
# automatically (see shell/load-env.zsh). Requires `op` on PATH.

# ─── AWS ───────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# ─── LLM API keys ──────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# HUGGINGFACE_TOKEN=hf_...

# ─── OpenRouter (used by `claw openrouter` / aichat) ───
# OPENROUTER_API_KEY=sk-or-...
# Or via 1Password:
# OPENROUTER_API_KEY=op://Personal/OpenRouter/api_key

# ─── Claw agent overrides (optional) ──────────
# Default Hermes model (Ollama). Defaults to hermes3:8b if unset.
# CLAW_HERMES_MODEL=hermes3:70b
# CLAW_HERMES_MODEL=nous-hermes2-mixtral
#
# Default OpenRouter model used by `claw openrouter`.
# Defaults to openrouter:anthropic/claude-sonnet-4.6 if unset.
# CLAW_OPENROUTER_MODEL=openrouter:meta-llama/llama-3.3-70b-instruct
# CLAW_OPENROUTER_MODEL=openrouter:anthropic/claude-opus-4.7

# ─── Other secrets ────────────────────────────
# Add any other sensitive environment variables below
